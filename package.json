{
	"name": "vigorous-virgo",
	"type": "module",
	"version": "0.0.1",
	"packageManager": "npm@11.19.0",
	"engines": {
		"node": "24.20.0"
	},
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"secure:pdfs": "python scripts/secure-public-pdfs.py",
		"secure:certs": "npm run secure:pdfs",
		"secure:headers": "node scripts/generate-security-headers.mjs",
		"check": "astro check",
		"format:check": "prettier --check \"README.md\" \".github/workflows/ci.yml\" \".github/workflows/deploy.yml\"",
		"build": "npm run secure:pdfs && astro check && astro build && npm run secure:headers",
		"preview": "astro preview",
		"astro": "astro"
	},
	"dependencies": {
		"@astrojs/check": "0.9.10",
		"@astrojs/markdown-satteri": "0.3.8",
