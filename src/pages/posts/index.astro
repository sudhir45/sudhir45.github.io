---
import Base from '@/layouts/Base.astro';
import PageHeading from '@/components/PageHeading.astro';
import PostList from '@/components/PostList.astro';
import { getAllPosts } from '@/utils/posts';
import { getAllTopicsWithCounts } from '@/utils/topics';
import { chronologicalPosts } from '@/utils/editorial';
const posts = chronologicalPosts(await getAllPosts());
const topics = await getAllTopicsWithCounts();
const years = [...new Set(posts.map((post) => post.data.pubDate.getUTCFullYear()))];
---

<Base
	head={{
		title: 'Writing | Sudhir',
		description: 'Essays, technical breakdowns, and notes from working in cybersecurity.'
	}}
>
	<div class="shell inner-page writing-archive">
		<PageHeading
			title="Writing"
			description="Essays, technical breakdowns, and notes from working in cybersecurity."
		/>
		<div class="archive-tools">
			<fieldset class="topic-filters">
				<legend class="sr-only">Filter by topic</legend>
				<button type="button" data-topic-filter="all" aria-pressed="true">All topics</button>
				{
					topics.map((topic) => (
						<button type="button" data-topic-filter={topic.name} aria-pressed="false">
							{topic.name}
						</button>
					))
				}
			</fieldset>
			<div class="archive-mobile-filter">
				<label for="topic-filter">Filter by topic</label>
				<select id="topic-filter"
					><option value="all">All topics</option>{
						topics.map((topic) => <option value={topic.name}>{topic.name}</option>)
					}</select>
			</div>
			<p id="archive-count" class="meta" role="status">{posts.length} posts</p>
		</div>
		{
			years.map((year) => (
				<section class="archive-year" data-year-group>
					<>
						<h2>{year}</h2>
						<PostList
							posts={posts.filter((post) => post.data.pubDate.getUTCFullYear() === year)}
							dense
							inlineDate
						/>
					</>
				</section>
			))
		}
		<p id="archive-empty" class="meta" hidden>
			No posts in this topic yet. Choose another topic or view all writing.
		</p>
	</div>
	<script>
		let abort: AbortController | undefined;
		document.addEventListener('astro:page-load', () => {
			abort?.abort();
			abort = new AbortController();
			const filter = document.querySelector<HTMLSelectElement>('#topic-filter');
			if (!filter) return;
			const rows = [...document.querySelectorAll<HTMLElement>('[data-post]')];
			const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-topic-filter]')];
			const apply = (topic: string) => {
				filter.value = topic;
				buttons.forEach((button) =>
					button.setAttribute('aria-pressed', String(button.dataset.topicFilter === topic))
				);
				let count = 0;
				rows.forEach((row) => {
					row.hidden =
						filter.value !== 'all' && !(row.dataset.topics || '').split('|').includes(filter.value);
					if (!row.hidden) count++;
				});
				document.querySelectorAll<HTMLElement>('[data-year-group]').forEach((group) => {
					group.hidden = !group.querySelector('[data-post]:not([hidden])');
				});
				document.getElementById('archive-count')!.textContent =
					`${count} ${count === 1 ? 'post' : 'posts'}`;
				document.getElementById('archive-empty')!.hidden = count > 0;
			};
			filter.addEventListener('change', () => apply(filter.value), { signal: abort.signal });
			buttons.forEach((button) =>
				button.addEventListener('click', () => apply(button.dataset.topicFilter || 'all'), {
					signal: abort!.signal
				})
			);
			apply(filter.value);
		});
		document.addEventListener('astro:before-swap', () => abort?.abort());
	</script>
</Base>
