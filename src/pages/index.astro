---
import Base from '@/layouts/Base.astro';
import { AppConfig } from '@/utils/AppConfig';
import { getAllPosts } from '@/utils/posts';
import { getTopicsWithCounts } from '@/utils/topics';
import { EDITORIAL, selectEditorialPosts, chronologicalPosts } from '@/utils/editorial';
import { getPresentations } from '@/utils/presentations';
import RiseTitle from '@/components/RiseTitle.astro';
import WorkaroundFigure from '@/components/WorkaroundFigure.astro';
import LeadSpread from '@/components/LeadSpread.astro';
import NumberedCard from '@/components/NumberedCard.astro';
import IndexList from '@/components/IndexList.astro';
import TalkFeature from '@/components/TalkFeature.astro';
import TopicIndex from '@/components/TopicIndex.astro';
import AuthorStrip from '@/components/AuthorStrip.astro';

const posts = await getAllPosts();
const [lead, ...supporting] = selectEditorialPosts(posts, EDITORIAL.home, 3);
const featured = new Set([lead, ...supporting].flatMap((post) => (post ? [post.slug] : [])));
const recent = chronologicalPosts(posts)
	.filter((post) => !featured.has(post.slug))
	.slice(0, EDITORIAL.recentLimit);
const topics = await getTopicsWithCounts();
const talk = getPresentations()[0];
const figureQuote = 'Each workaround creates a path the original design did not consider.';
const figureEssay = posts.find((post) => post.slug === 'good-enough-security')?.url ?? '/posts';
---

<Base head={{ title: AppConfig.title, description: AppConfig.description }}>
	<div class="shell home">
		<section class="hero grid-12" aria-labelledby="hero-title" data-reveal data-arrival>
			<RiseTitle
				level={1}
				id="hero-title"
				class="hero-title"
				lines={['Security work,', 'written down.']}
				delay={350}
			/>
			<div class="hero-intro">
				<div class="hero-rule" data-draw style="--delay:1000ms"></div>
				<p class="ui" data-show style="--delay:1100ms">
					I'm Sudhir, a CISSP-certified Cyber Security Professional working on enterprise security,
					governance, compliance, and validation. I write practical notes on how security controls
					are designed, assessed, operated, and evidenced in large enterprise environments.
				</p>
			</div>
			<div class="hero-figure">
				<WorkaroundFigure quote={figureQuote} href={figureEssay} />
			</div>
		</section>

		{lead && <LeadSpread post={lead} />}

		{
			supporting.length > 0 && (
				<section class="selected" aria-labelledby="selected-heading" data-reveal>
					<div class="section-label">
						<h2 id="selected-heading">Selected writing</h2>
						<span data-draw />
					</div>
					<div class="selected-grid grid-12">
						{supporting.map((post, i) => (
							<NumberedCard post={post} number={String(i + 2).padStart(2, '0')} delay={100 + i * 100} />
						))}
					</div>
				</section>
			)
		}

		<section class="more" aria-labelledby="more-heading">
			<div class="section-head">
				<h2 id="more-heading">More from the writing</h2>
				<a href="/posts" class="text-link all-posts is-top"
					>All {posts.length} posts <span class="arrow" aria-hidden="true">→</span></a
				>
			</div>
			<IndexList posts={recent} reveal />
			<a href="/posts" class="text-link all-posts is-bottom"
				>All {posts.length} posts <span class="arrow" aria-hidden="true">→</span></a
			>
		</section>

		{
			talk && (
				<section class="talk-section" aria-label="Latest talk">
					<TalkFeature talk={talk} />
				</section>
			)
		}

		<TopicIndex topics={topics} posts={posts} />

		<AuthorStrip />
	</div>
</Base>

<style>
	.hero {
		row-gap: 56px;
		padding-top: clamp(40px, 5.3vw, 76px);
	}
	.hero :global(.hero-title) {
		grid-column: 1 / -1;
		font-size: var(--text-hero);
		font-weight: 420;
		line-height: 0.93;
		letter-spacing: -0.035em;
	}
	.hero :global(.hero-title .is-italic) {
		padding-left: 0.76em;
		font-weight: 300;
	}
	.hero-intro {
		grid-column: 1 / span 5;
		align-self: start;
		padding-top: 6px;
	}
	.hero-rule {
		width: 48px;
		height: 1px;
		margin-bottom: 20px;
		background: var(--accent);
	}
	.hero-intro p {
		font-size: var(--text-body);
		line-height: 1.62;
		color: var(--body-ink);
	}
	.hero-figure {
		grid-column: 7 / span 6;
		align-self: center;
	}

	.selected {
		display: flex;
		flex-direction: column;
		gap: 28px;
		padding-bottom: 84px;
	}
	.selected-grid > :global(:first-child) {
		grid-column: 1 / span 5;
	}
	.selected-grid > :global(:nth-child(2)) {
		grid-column: 7 / span 5;
	}

	.more {
		padding-bottom: 88px;
	}
	/* On phones the link to the archive follows the list, where a reader finishes it. */
	.all-posts.is-bottom {
		display: none;
		margin-top: 12px;
		font-size: var(--text-ui);
	}
	@media (max-width: 767px) {
		.all-posts.is-top {
			display: none;
		}
		.all-posts.is-bottom {
			display: inline-flex;
		}
	}

	.talk-section {
		padding-bottom: 88px;
	}


	@media (max-width: 1099px) {
		.hero-intro {
			grid-column: 1 / span 8;
		}
		.hero-figure {
			grid-column: 1 / -1;
		}
		.selected-grid > :global(:first-child) {
			grid-column: 1 / span 6;
		}
		.selected-grid > :global(:nth-child(2)) {
			grid-column: 7 / span 6;
		}
	}
	@media (max-width: 767px) {
		.hero {
			row-gap: 40px;
		}
		.hero :global(.hero-title .is-italic) {
			padding-left: 0.6em;
		}
		.hero-intro,
		.hero-figure,
		.selected-grid > :global(*) {
			grid-column: 1 / -1 !important;
		}
		.hero-intro p {
			font-size: var(--text-ui-lg);
		}
		.selected-grid {
			row-gap: 44px;
		}
		.selected,
		.more,
		.talk-section {
			padding-bottom: 64px;
		}
	}
</style>
