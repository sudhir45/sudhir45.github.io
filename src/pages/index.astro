---
import Base from '@/layouts/Base.astro';
import { AppConfig } from '@/utils/AppConfig';
import { Image } from 'astro:assets';
import avatar from '@/assets/images/avatar.png';
import { getAllPosts } from '@/utils/posts';
import { getAllTopicsWithCounts } from '@/utils/topics';
import { EDITORIAL, selectEditorialPosts, chronologicalPosts, longDate } from '@/utils/editorial';
import PostList from '@/components/PostList.astro';
import TopicList from '@/components/TopicList.astro';
import BoundaryIllustration from '@/components/BoundaryIllustration.astro';
import { getPresentations } from '@/utils/presentations';
import TalkCover from '@/components/TalkCover.astro';
const posts = await getAllPosts();
const [lead, ...supporting] = selectEditorialPosts(posts, EDITORIAL.home, 3);
const featured = new Set([lead, ...supporting].flatMap((post) => (post ? [post.slug] : [])));
const recent = chronologicalPosts(posts)
	.filter((post) => !featured.has(post.slug))
	.slice(0, EDITORIAL.recentLimit);
const topics = await getAllTopicsWithCounts();
const talk = getPresentations()[0];
---

<Base head={{ title: AppConfig.title, description: AppConfig.description }}>
	<div class="shell">
		<div class="introduction">
			<p>
				<span class="underline"> Security work, written down. </span>
				<br>
				I'm Sudhir, a CISSP-certified Cyber Security Professional
				working on enterprise security, governance, compliance, and validation. I write practical
				notes on how security controls are designed, assessed, operated, and evidenced in large
				enterprise environments.
			</p>
		</div>
		{
			lead ? (
				<section class="lead" aria-labelledby="lead-title">
					<>
						<div class="lead-copy">
							<>
								<div class="category">
									<>
										<span>{lead.data.tags[0]}</span>
										<span aria-hidden="true">-</span>
										<span>Essay</span>
									</>
								</div>
								<h1 id="lead-title" transition:name={`post-title-${lead.slug}`}>
									<a href={lead.url}>{lead.data.title}</a>
								</h1>
								<p class="lead-description">{lead.data.description}</p>
								<div class="lead-bottom">
									<>
										<a href={lead.url} class="text-link">
											Read the essay <span aria-hidden="true">↗</span>
										</a>
										<span class="meta">{lead.data.minutesRead}</span>
									</>
								</div>
							</>
						</div>
						<figure class="lead-art">
							<>
								<BoundaryIllustration />
								<figcaption>The exception becomes the route.</figcaption>
							</>
						</figure>
					</>
				</section>
			) : (
				<header class="page-heading">
					<>
						<h1>Security work, written down.</h1>
						<p>New writing will appear here.</p>
					</>
				</header>
			)
		}
		{
			supporting.length > 0 && (
				<section class="supporting" aria-label="Selected writing">
					{supporting.map((post) => (
						<article>
							<span class="meta">
								{post.data.tags[0]} · {post.data.minutesRead}
							</span>
							<h2>
								<a href={post.url}>{post.data.title}</a>
							</h2>
							<p>{post.data.description}</p>
							<a href={post.url} class="text-link">
								Read essay <span aria-hidden="true">→</span>
							</a>
						</article>
					))}
				</section>
			)
		}
		<section class="writing" aria-labelledby="writing-heading">
			<div class="section-head">
				<h2 id="writing-heading">More from the writing</h2><a href="/posts" class="text-link"
					>All {posts.length} posts <span aria-hidden="true">→</span></a
				>
			</div><PostList posts={recent} compact />
		</section>
		{
			talk && (
				<section class="talk" aria-labelledby="talk-heading">
					<>
						<a href={`/presentations/${talk.slug}`} aria-label={`Open ${talk.title} slides`}>
							<TalkCover
								slug={talk.slug}
								title={talk.title}
								thumbnail={talk.thumbnail}
								coverImage={talk.coverImage}
							/>
						</a>
						<div>
							<>
								<p class="meta">
									{['Talk', talk.date && longDate(talk.date), `${talk.slideCount} slides`]
										.filter(Boolean)
										.join(' · ')}
								</p>
								<h2 id="talk-heading">{talk.title.replace(' :', ':')}</h2>
								<p class="meta">{talk.venue}</p>
								<a href={`/presentations/${talk.slug}`} class="text-link">
									View the slides <span aria-hidden="true">→</span>
								</a>
							</>
						</div>
					</>
				</section>
			)
		}
		<section class="topics" aria-labelledby="topics-heading">
			<div class="topics-intro">
				<h2 id="topics-heading">Browse by topic</h2><p>
					Choose a subject to see the related writing.
				</p>
			</div><TopicList topics={topics} />
		</section>
		<section class="author" aria-label="About the author">
			<Image src={avatar} width={144} height={144} format="webp" alt="Sudhir" /><p>
				I'm a Cyber Security Professional. I write about how security decisions play out in
				practice. <a href="/about">More about me ↗</a>
			</p>
		</section>
	</div>
</Base>
