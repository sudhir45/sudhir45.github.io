---
import Base from '@/layouts/Base.astro';
import PageHeading from '@/components/PageHeading.astro';
import PostList from '@/components/PostList.astro';
import { getAllPosts, type SitePost } from '@/utils/posts';
import { TOPICS, type Topic } from '@/utils/topics';
export async function getStaticPaths() {
	const posts = await getAllPosts();
	return TOPICS.map((topic) => ({
		params: { tag: topic.slug },
		props: { topic, posts: posts.filter((post) => post.data.tags.includes(topic.name)) }
	}));
}
interface Props {
	topic: Topic;
	posts: SitePost[];
}
const { topic, posts } = Astro.props;
---

<Base head={{ title: `${topic.name} | Sudhir`, description: topic.description }}
	><div class="shell inner-page">
		<a href="/tags" class="back-link text-link">← All topics</a><PageHeading
			title={topic.name}
			description={topic.description}
		/><p class="meta archive-summary">
			{posts.length}
			{posts.length === 1 ? 'post' : 'posts'}
		</p><PostList posts={posts} />{
			posts.length === 0 && <p>No writing here yet. Browse the other topics below.</p>
		}<div class="other-topics">
			<h2>Other topics</h2><nav aria-label="Other topics">
				{
					TOPICS.filter((t) => t.slug !== topic.slug).map((t) => (
						<a href={`/tags/${t.slug}`}>{t.name}</a>
					))
				}
			</nav>
		</div>
	</div></Base
>
