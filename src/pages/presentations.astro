---
import Base from '@/layouts/Base.astro';
import PageHeading from '@/components/PageHeading.astro';
import TalkFeature from '@/components/TalkFeature.astro';
import { getPresentations } from '@/utils/presentations';
const talks = getPresentations();
---

<Base head={{ title: 'Talks | Sudhir', description: 'Security ideas, shared beyond the blog.' }}>
	<div class="shell">
		<PageHeading title="Talks &" tail="appearances" description="Security ideas, shared beyond the blog." />
		<div class="talk-list">
			{
				talks.map((talk, index) => (
					<TalkFeature talk={talk} description headingLevel="h2" loading={index === 0 ? 'eager' : 'lazy'} />
				))
			}
		</div>
		{talks.length === 0 && <p class="meta">Talks will appear here as they are added.</p>}
	</div>
</Base>

<style>
	.talk-list {
		display: flex;
		flex-direction: column;
		gap: 64px;
		padding-top: clamp(32px, 5vw, 56px);
	}
	.talk-list > :global(* + *) {
		padding-top: 64px;
		border-top: 1px solid var(--line);
	}
</style>
