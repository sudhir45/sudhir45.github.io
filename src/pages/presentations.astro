---
import Base from '@/layouts/Base.astro';
import PageHeading from '@/components/PageHeading.astro';
import { getPresentations } from '@/utils/presentations';
import TalkCover from '@/components/TalkCover.astro';
import { longDate } from '@/utils/editorial';
const talks = getPresentations();
---

<Base head={{ title: 'Talks | Sudhir', description: 'Security ideas, shared beyond the blog.' }}
	><div class="shell inner-page">
		<PageHeading
			title="Talks & appearances"
			description="Security ideas, shared beyond the blog."
		/><div class="talk-list">
			{
				talks.map((talk, index) => (
					<article class="talk-feature">
						<>
							<a href={`/presentations/${talk.slug}`}>
								<TalkCover
									slug={talk.slug}
									title={talk.title}
									thumbnail={talk.thumbnail}
									coverImage={talk.coverImage}
									loading={index === 0 ? 'eager' : 'lazy'}
								/>
							</a>
							<div>
								<>
									<p class="meta">
										{[talk.date && longDate(talk.date), talk.venue].filter(Boolean).join(' · ')}
									</p>
									<h2>
										<a href={`/presentations/${talk.slug}`}>{talk.title.replace(' :', ':')}</a>
									</h2>
									<p>{talk.description}</p>
									<a href={`/presentations/${talk.slug}`} class="text-link">
										View {talk.slideCount} slides →
									</a>
								</>
							</div>
						</>
					</article>
				))
			}
		</div>{talks.length === 0 && <p class="meta">Talks will appear here as they are added.</p>}
	</div></Base
>
