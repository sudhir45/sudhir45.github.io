---
import Base from '@/layouts/Base.astro';
---

<Base
	head={{ title: 'Page not found | Sudhir', description: 'This page does not exist or has moved.' }}
>
	<div class="shell inner-page">
		<section class="not-found" aria-labelledby="missing-title">
			<div class="missing-copy">
				<p class="category">404 · Page not found</p><h1 id="missing-title">Nothing here.</h1><p>
					The page you're looking for may have moved, or the address isn't quite right.
				</p><div class="recovery-links">
					<a href="/" class="text-link">← Back home</a><a href="/posts" class="text-link"
						>Browse the writing</a>
				</div><button
					type="button"
					data-search-trigger
					aria-controls="search-modal"
					aria-expanded="false"
					class="missing-search">Search the site →</button>
			</div><figure class="missing-scene">
				<div class="missing-stage">
					<span class="missing-number" aria-hidden="true">404</span><img
						id="looking-around"
						src="/images/travolta-confused.gif"
						width="250"
						height="250"
						alt="John Travolta looks around, confused, and finds nothing."
					/><canvas
						id="looking-still"
						width="250"
						height="250"
						role="img"
						aria-label="John Travolta looking around, confused."
						hidden></canvas>
				</div><figcaption>
					<span>He can't find it either.</span><button id="meme-motion" hidden
						>Pause animation</button>
				</figcaption>
			</figure>
		</section>
	</div>
	<script>
		let cleanup: (() => void) | undefined;
		document.addEventListener('astro:page-load', () => {
			cleanup?.();
			const img = document.querySelector<HTMLImageElement>('#looking-around'),
				canvas = document.querySelector<HTMLCanvasElement>('#looking-still'),
				button = document.querySelector<HTMLButtonElement>('#meme-motion');
			if (!img || !canvas || !button) return;
			const reduced = matchMedia('(prefers-reduced-motion: reduce)');
			const abort = new AbortController();
			let paused = reduced.matches;
			const render = () => {
				if (!img.complete || !img.naturalWidth) return;
				canvas.getContext('2d')?.drawImage(img, 0, 0, 250, 250);
				canvas.hidden = !paused;
				img.hidden = paused;
				button.hidden = false;
				button.textContent = paused ? 'Play animation' : 'Pause animation';
				button.setAttribute('aria-pressed', String(paused));
			};
			img.addEventListener('load', render, { signal: abort.signal });
			button.addEventListener(
				'click',
				() => {
					paused = !paused;
					img.classList.toggle('motion-enabled', !paused);
					render();
				},
				{ signal: abort.signal }
			);
			reduced.addEventListener(
				'change',
				() => {
					paused = reduced.matches;
					render();
				},
				{ signal: abort.signal }
			);
			render();
			cleanup = () => abort.abort();
		});
		document.addEventListener('astro:before-swap', () => cleanup?.());
	</script>
</Base>
