---
/**
 * Folio component sheet: every shared component and token in both themes.
 * Not linked, noindex, and excluded from the sitemap. The in-code twin of the
 * "Components and tokens" artboard from the original design.
 */
import Base from '@/layouts/Base.astro';
import PageHeading from '@/components/PageHeading.astro';
import IndexList from '@/components/IndexList.astro';
import NumberedCard from '@/components/NumberedCard.astro';
import TopicSentence from '@/components/TopicSentence.astro';
import TopicIndex from '@/components/TopicIndex.astro';
import TalkFeature from '@/components/TalkFeature.astro';
import WorkaroundFigure from '@/components/WorkaroundFigure.astro';
import DoubleRule from '@/components/DoubleRule.astro';
import PullQuote from '@/components/PullQuote.astro';
import { getAllPosts } from '@/utils/posts';
import { getTopicsWithCounts } from '@/utils/topics';
import { getPresentations } from '@/utils/presentations';

const posts = await getAllPosts();
const topics = await getTopicsWithCounts();
const talk = getPresentations()[0];
const colours = [
	['--bg', 'Paper'],
	['--surface-2', 'Surface 2'],
	['--fg', 'Ink'],
	['--body-ink', 'Body ink'],
	['--muted', 'Muted'],
	['--line', 'Line'],
	['--frame', 'Frame'],
	['--accent', 'Amber']
];
const type = [
	['--text-hero', 'Hero', 'Security work,'],
	['--text-title', 'Post title', 'Why theoretical'],
	['--text-lead-title', 'Lead title', 'Selected essay'],
	['--text-section', 'Section', 'Browse by topic'],
	['--text-deck', 'Deck (italic)', 'How to choose controls'],
	['--text-prose', 'Prose', 'A control can be secure on paper.']
];
const themes = [
	{ id: 'light', label: 'Light' },
	{ id: 'dark', label: 'Dark' }
];
---

<Base
	head={{
		title: 'Specs | Sudhir',
		description: 'Folio components and tokens in both themes.',
		noindex: true
	}}
>
	<div class="shell">
		<PageHeading
			title="Components"
			tail="and tokens"
			description="Every shared Folio component in both themes. This page is not linked from the site."
		/>
	</div>
	{
		themes.map((theme) => (
			<section class:list={['sheet', { dark: theme.id === 'dark' }]} aria-label={`${theme.label} theme`}>
				<div class="shell">
					<p class="sc sheet-label">{theme.label} theme</p>

					<h2 class="spec-h">Colour</h2>
					<ul class="swatches">
						{colours.map(([token, name]) => (
							<li>
								<span class="swatch" style={`background:var(${token})`} />
								<span class="ui">{name}</span>
								<code>{token}</code>
							</li>
						))}
					</ul>

					<h2 class="spec-h">Type</h2>
					<ul class="type">
						{type.map(([token, name, sample]) => (
							<li>
								<code>
									{name} · {token}
								</code>
								<span class:list={['sample', { deck: token === '--text-deck' }]} style={`font-size:min(var(${token}), 96px)`}>
									{sample}
								</span>
							</li>
						))}
						<li>
							<code>Small caps · --text-smallcaps</code>
							<span class="sc">Selected writing</span>
						</li>
					</ul>

					<h2 class="spec-h">Rules and links</h2>
					<DoubleRule />
					<div class="row-demo ui">
						<a href="/posts" class="text-link">
							Read the essay <span class="arrow" aria-hidden="true">↗</span>
						</a>
						<a href="/tags" class="grow-link">Footer link</a>
						<button type="button" class="btn-line">
							Search <kbd>Ctrl K</kbd>
						</button>
					</div>

					<h2 class="spec-h">Hero figure</h2>
					<div class="figure-demo">
						<WorkaroundFigure
							uid={`spec-${theme.id}`}
							quote="Each workaround creates a path the original design did not consider."
							href="/posts/good-enough-security"
						/>
					</div>

					<h2 class="spec-h">Numbered cards</h2>
					<div class="grid-12 cards">
						{posts.slice(1, 3).map((post, i) => (
							<NumberedCard post={post} number={String(i + 2).padStart(2, '0')} transition={false} />
						))}
					</div>

					<h2 class="spec-h">Index list</h2>
					<IndexList posts={posts.slice(3, 6)} transitions={false} />

					<h2 class="spec-h">Topic sentence</h2>
					<TopicSentence topics={topics} />

					<h2 class="spec-h">Topic index</h2>
					<TopicIndex topics={topics} posts={posts} id={`spec-topics-${theme.id}`} />

					<h2 class="spec-h">Pull quote</h2>
					<div class="grid-12">
						<div class="prose quote-demo">
							<p>Pull quotes float into the margin from 1100px and sit inline below that.</p>
							<PullQuote>Each workaround creates a path the original design did not consider.</PullQuote>
							<p>
								Security teams often evaluate a control by asking whether it blocks a threat. Users
								evaluate it every time they try to finish a task.
							</p>
							<ol>
								<li>Which attack or mistake does this control address?</li>
								<li>What happens when the control blocks legitimate work?</li>
							</ol>
						</div>
					</div>

					{talk && (
						<>
							<h2 class="spec-h">Talk feature</h2>
							<TalkFeature talk={talk} headingLevel="h3" />
						</>
					)}
				</div>
			</section>
		))
	}
</Base>

<style>
	.sheet {
		padding-block: 48px 72px;
		background: var(--bg);
		color: var(--fg);
	}
	.sheet + .sheet {
		border-top: 1px solid var(--line);
	}
	.sheet-label {
		color: var(--accent);
	}
	.spec-h {
		margin: 56px 0 18px;
		padding-bottom: 8px;
		border-bottom: 1px solid var(--line);
		font: 600 var(--text-smallcaps) var(--font-ui);
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	code {
		font: 400 12px var(--font-code);
		color: var(--muted);
	}
	.swatches {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
		gap: 20px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.swatches li {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.swatch {
		height: 64px;
		border: 1px solid var(--line);
	}
	.type {
		display: flex;
		flex-direction: column;
		gap: 18px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.type li {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.sample {
		overflow: hidden;
		font-family: var(--font-display-stack);
		line-height: 1.05;
		white-space: nowrap;
		text-overflow: ellipsis;
	}
	.sample.deck {
		font-style: italic;
		color: var(--body-ink);
	}
	.row-demo {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 16px 32px;
		margin-top: 24px;
	}
	.figure-demo {
		max-width: 680px;
	}
	.cards > :global(:first-child) {
		grid-column: 1 / span 5;
	}
	.cards > :global(:nth-child(2)) {
		grid-column: 7 / span 5;
	}
	.quote-demo {
		grid-column: 1 / span 8;
	}
	@media (max-width: 767px) {
		.cards > :global(*),
		.quote-demo {
			grid-column: 1 / -1;
		}
		.cards {
			row-gap: 40px;
		}
	}
</style>
