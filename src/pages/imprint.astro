---
import PageHeading from '@/components/PageHeading.astro';
import Base from '@/layouts/Base.astro';
import { AppConfig } from '@/utils/AppConfig';

const title = `Imprint | ${AppConfig.site_name}`;
const description = 'Imprint, privacy, and legal information for sudhir.is-a.dev.';
const analyticsEnabled = Boolean(import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim());
---

<Base head={{ title, description }}>
	<div class="shell">
		<PageHeading title="Imprint" description="Legal information for sudhir.is-a.dev." />
		<div class="legal grid-12">
			<div class="prose">
				<section>
					<h2>Site &amp; responsibility</h2>
					<p>
						Sudhir · <a href="https://sudhir.is-a.dev" target="_blank" rel="noopener noreferrer"
							>sudhir.is-a.dev</a
						><br />
						Responsible for content and editorial: Sudhir.
					</p>
				</section>

				<section>
					<h2>Graphics and images</h2>
					<p>
						Unless specified otherwise, Sudhir is the creator of all graphics and images on this
						site.
					</p>
				</section>

				<section id="privacy">
					<h2>Privacy and analytics</h2>
					{
						analyticsEnabled ? (
							<>
								<p>
									This site uses Google Analytics 4 to count page views. When it runs, your browser
									loads Google's tag from googletagmanager.com and sends Google the page path and
									title, the page you came from, and technical details such as browser, device type,
									and screen size. Google derives an approximate location from your IP address.
									Query strings and anything after <code>#</code> are removed before sending. Google
									sets two first-party cookies, <code>_ga</code> and <code>_ga_&lt;id&gt;</code>, to
									tell repeat visits apart.
								</p>
								<p>
									Analytics does not load if your browser sends Global Privacy Control, or after you
									turn it off here. The choice is stored in this browser only.
								</p>
								<p class="analytics-control" data-analytics-control>
									<span data-analytics-status>Analytics is on in this browser.</span>{' '}
									<button type="button" class="btn-line" data-analytics-toggle>
										Turn analytics off
									</button>
								</p>
							</>
						) : (
							<p>This site does not load analytics.</p>
						)
					}
					<p>A few settings live in your browser's storage. They never leave your device.</p>
					<ul>
						<li><code>theme</code> · light or dark mode</li>
						<li><code>motion</code> · the motion level chosen in the footer</li>
						<li>
							<code>cyberdle:v1:*</code> · Cyberdle progress, statistics, and the random offset that picks
							your daily word
						</li>
						<li><code>analytics</code> · your analytics choice, if you made one</li>
						<li>
							<code>folio:arrived</code> (session storage) · plays the homepage intro once per visit
						</li>
					</ul>
				</section>

				<section>
					<h2>Disclaimer</h2>

					<h3>Liability for content</h3>
					<p>
						All content on our website has been created with the utmost care and to the best of our
						knowledge. However, we cannot guarantee the accuracy, completeness, and timeliness of
						the content. As a service provider, we are responsible for our own content on these
						pages in accordance with § 7 (1) TMG. According to §§ 8 to 10 TMG, we as service
						providers are not obligated to monitor transmitted or stored third-party information or
						to investigate circumstances that indicate illegal activity. Obligations to remove or
						block the use of information under general law remain unaffected by this.
					</p>
					<p>
						However, liability in this regard is only possible from the time of knowledge of a
						specific legal violation. Upon becoming aware of such legal violations, we will remove
						this content immediately.
					</p>

					<h3>Limitation of liability for external links</h3>
					<p>
						Our website contains links to external websites of third parties. We have no influence
						on the content of these directly or indirectly linked websites. Therefore, we cannot
						assume any liability for the "external links." The respective provider or operator
						(author) of the pages is responsible for the content of the external links.
					</p>
					<p>
						If we become aware of legal violations, the external links will be removed by us
						immediately.
					</p>

					<h3>Copyright</h3>
					<p>
						The content and works published on this website are subject to <a
							href="http://www.gesetze-im-internet.de/bundesrecht/urhg/gesamt.pdf"
							>applicable copyright law</a
						>. The reproduction, processing, distribution, and any kind of exploitation beyond the
						limits of copyright require the prior written consent of the respective author in
						intellectual and material terms. Downloads and copies of this page are only permitted
						for private and non-commercial use. If the content on this website was not created by
						the operator, the copyrights of third parties are observed. Third-party content is
						identified as such. If you nevertheless become aware of a copyright infringement, please
						let me know and the content will be removed immediately.
					</p>
				</section>
			</div>
		</div>
	</div>
</Base>

<script>
	import { onPage } from '@/motion/lifecycle';

	const KEY = 'analytics';

	function readOptOut() {
		try {
			return localStorage.getItem(KEY) === 'off';
		} catch {
			return false;
		}
	}

	// Remove Google's _ga cookies at every domain level they may have been set on.
	function clearGaCookies() {
		const parts = location.hostname.split('.');
		const domains = [''];
		for (let i = 0; i < parts.length - 1; i++)
			domains.push(`; domain=.${parts.slice(i).join('.')}`);
		document.cookie
			.split(';')
			.map((cookie) => cookie.split('=')[0]?.trim() ?? '')
			.filter((name) => name === '_ga' || name.startsWith('_ga_'))
			.forEach((name) => {
				domains.forEach((domain) => {
					document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/${domain}`;
				});
			});
	}

	onPage((signal) => {
		const control = document.querySelector<HTMLElement>('[data-analytics-control]');
		const button = control?.querySelector<HTMLButtonElement>('[data-analytics-toggle]');
		const status = control?.querySelector<HTMLElement>('[data-analytics-status]');
		if (!control || !button || !status) return;

		const gpc = (navigator as Navigator & { globalPrivacyControl?: boolean }).globalPrivacyControl;
		const render = () => {
			const off = readOptOut();
			if (gpc && !off) {
				status.textContent = 'Analytics is off because your browser sends Global Privacy Control.';
				button.hidden = true;
				return;
			}
			status.textContent = off
				? 'Analytics is off in this browser.'
				: 'Analytics is on in this browser.';
			button.textContent = off ? 'Turn analytics on' : 'Turn analytics off';
		};

		button.addEventListener(
			'click',
			() => {
				const off = !readOptOut();
				try {
					if (off) localStorage.setItem(KEY, 'off');
					else localStorage.removeItem(KEY);
				} catch {
					status.textContent = 'This browser blocks storage, so the choice cannot be saved.';
					return;
				}
				const id = (window as unknown as Record<string, unknown>).__gaMeasurementId;
				if (typeof id === 'string') {
					(window as unknown as Record<string, unknown>)[`ga-disable-${id}`] = off;
				}
				if (off) clearGaCookies();
				render();
				if (!off && typeof (window as unknown as Record<string, unknown>).gtag !== 'function') {
					status.textContent = 'Analytics is on. It starts after the page reloads.';
				}
			},
			{ signal }
		);
		render();
	});
</script>

<style>
	.legal {
		padding-top: 48px;
	}
	.prose {
		grid-column: 4 / span 6;
	}
	.prose :global(section + section) {
		margin-top: 40px;
	}
	.prose :global(section > p) {
		margin-bottom: 18px;
	}
	.prose :global(h2) {
		margin-top: 0;
	}
	.analytics-control {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px 16px;
	}
	@media (max-width: 1099px) {
		.prose {
			grid-column: 2 / span 10;
		}
	}
	@media (max-width: 767px) {
		.prose {
			grid-column: 1 / -1;
		}
	}
</style>
