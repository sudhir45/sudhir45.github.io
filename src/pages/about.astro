---
import Base from '@/layouts/Base.astro';
import { SOCIALS } from '@/utils/AppConfig';
import { Image } from 'astro:assets';
import avatar from '@/assets/images/avatar.png';
import { getAllPosts } from '@/utils/posts';
import { EDITORIAL, selectEditorialPosts } from '@/utils/editorial';
import PostList from '@/components/PostList.astro';
const picks = selectEditorialPosts(await getAllPosts(), EDITORIAL.about, 3);
---

<Base
	head={{
		title: 'About | Sudhir',
		description: 'I work in cybersecurity. I write about what holds up in practice.'
	}}
>
	<div class="shell inner-page">
		<div class="profile-overview">
			<section class="profile-hero" aria-labelledby="profile-name">
				<div class="profile-opening">
					<h1 id="profile-name">About Sudhir</h1><p class="profile-deck">
						I work in cybersecurity. I write about what holds up in practice.
					</p>
				</div><div class="profile-identity">
					<figure class="profile-photo">
						<Image
							src={avatar}
							width={288}
							height={288}
							format="webp"
							loading="eager"
							alt="Sudhir"
						/>
					</figure><div class="profile-credentials">
						<span>CISSP-certified</span><a
							href="/resume.pdf"
							target="_blank"
							rel="noopener noreferrer">View resume ↗</a>
					</div>
				</div>
			</section>
			<section class="profile-story" aria-label="Background">
				<div class="profile-prose">
					<p>
						Earlier, a lot of my time went into CTFs and offensive security. That still shapes how I
						approach defense. I think about how a control could fail, and what someone could do with
						that failure.
					</p><p>
						This site is where I work through those questions in writing. Some posts take apart a
						technical problem. Others cover a security decision, an exam, or CTF challenges I
						solved.
					</p>
				</div>
			</section>
		</div>
		{
			picks.length > 0 && (
				<section class="profile-reading" aria-labelledby="profile-reading-title">
					<>
						<div class="profile-section-heading">
							<>
								<h2 id="profile-reading-title">A few places to start.</h2>
								<a href="/posts" class="text-link">
									All writing →
								</a>
							</>
						</div>
						<PostList posts={picks} inlineDate />
					</>
				</section>
			)
		}
		<section class="profile-contact" aria-labelledby="profile-contact-title">
			<h2 id="profile-contact-title">Elsewhere</h2><nav aria-label="Contact Sudhir">
				{
					SOCIALS.map((social) => (
						<a
							href={social.url}
							target={social.url.startsWith('http') ? '_blank' : undefined}
							rel={social.url.startsWith('http') ? 'noopener noreferrer' : undefined}
						>
							{social.name === 'Email' ? 'Email me' : social.name} ↗
						</a>
					))
				}
			</nav>
		</section>
	</div>
</Base>
