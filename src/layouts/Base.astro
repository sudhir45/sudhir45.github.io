---
import Footer from '@/components/Footer.astro';
import Masthead from '@/components/Masthead.astro';
import { AppConfig, SOCIALS } from '@/utils/AppConfig';
import '@/styles/global.css';
import serifDisplay from '@/assets/fonts/source-serif-display-normal.woff2?url';
import GoogleAnalytics from '@/components/GoogleAnalytics.astro';
import { ClientRouter } from 'astro:transitions';

export interface Props {
	head: {
		title: string;
		description: string;
		image?: string;
		/** Keep the page out of search results (utility pages such as /specs). */
		noindex?: boolean;
		/** Open Graph type "profile" for the About page. */
		profile?: boolean;
		article?: {
			publishedTime: string;
			modifiedTime?: string;
			tags?: string[];
		};
	};
	/** Compact reading masthead for posts. */
	masthead?: {
		variant: 'site' | 'post';
		runningTitle?: string;
		minutes?: number;
	};
}

const {
	head: { title, description, image, noindex = false, profile = false, article },
	masthead = { variant: 'site' }
} = Astro.props as Props;

const authorSameAs = SOCIALS.filter((s) => s.url.startsWith('http')).map((s) => s.url);

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://sudhir.is-a.dev';
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
const baseOgImage = image ?? '/images/sudhir-social-card-v2.png';
const ogImageUrl = baseOgImage.startsWith('http') ? baseOgImage : `${siteUrl}${baseOgImage}`;
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		<!-- Browser bar colour; theme.ts keeps it in step with the page theme. Dark is the default. -->
		<meta name="theme-color" content="#1f1b17" data-theme-color />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={AppConfig.author} />
		<meta
			name="robots"
			content={noindex
				? 'noindex, nofollow'
				: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
		/>
		<meta http-equiv="X-Content-Type-Options" content="nosniff" />
		<meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />

		<link rel="canonical" href={canonicalUrl} />

		<meta property="og:type" content={article ? 'article' : profile ? 'profile' : 'website'} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content={AppConfig.site_name} />
		<meta property="og:locale" content="en_IN" />
		{article && <meta property="article:published_time" content={article.publishedTime} />}
		{
			article?.modifiedTime && (
				<meta property="article:modified_time" content={article.modifiedTime} />
			)
		}
		{article && <meta property="article:author" content={AppConfig.author} />}
		{article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
		{ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
		{ogImageUrl && <meta property="og:image:width" content="1200" />}
		{ogImageUrl && <meta property="og:image:height" content="630" />}
		{ogImageUrl && <meta property="og:image:alt" content={title} />}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
		{ogImageUrl && <meta name="twitter:image:alt" content={title} />}

		<link rel="dns-prefetch" href="https://www.googletagmanager.com" />
		<link rel="preload" href={serifDisplay} as="font" type="font/woff2" crossorigin />

		<link rel="icon" type="image/svg+xml" href="/assets/img/favicons/favicon.svg?v=20260718" />
		<link
			rel="icon"
			type="image/png"
			href="/assets/img/favicons/favicon-96x96.png?v=20260718"
			sizes="96x96"
		/>
		<link rel="shortcut icon" href="/assets/img/favicons/favicon.ico?v=20260718" />
		<link rel="apple-touch-icon" href="/assets/img/favicons/apple-touch-icon.png?v=20260718" />
		<link rel="manifest" href="/manifest.json" />

		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="alternate" type="application/rss+xml" href="/rss.xml" title={AppConfig.title} />

		<script
			type="application/ld+json"
			is:inline
			set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@type': 'Blog',
				name: AppConfig.site_name,
				description: AppConfig.description,
				url: Astro.site?.toString() || 'https://sudhir.is-a.dev',
				author: {
					'@type': 'Person',
					name: AppConfig.author,
					url: `${siteUrl}/about`,
					sameAs: authorSameAs
				},
				publisher: {
					'@type': 'Person',
					name: AppConfig.author
				}
			})}
		/>

		<GoogleAnalytics />
		<ClientRouter />
		<script is:inline>
			(() => {
				const root = document.documentElement;
				let saved, motion;
				try {
					saved = localStorage.getItem('theme');
					motion = localStorage.getItem('motion');
				} catch {}
				// Dark is the default; a saved light choice from the toggle wins.
				root.classList.toggle('dark', saved !== 'light');
				if (!['full', 'reduced', 'off'].includes(motion))
					motion = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'reduced' : 'full';
				root.dataset.motion = motion;
				// Safety net: if motion code has not booted, everything resolves to its final state.
				if (motion === 'full')
					setTimeout(() => {
						if (!window.__folioMotion) root.dataset.motion = 'reduced';
					}, 2500);
			})();
		</script>
		<script>
			import '@/utils/theme';
			import '@/motion/runtime';
		</script>
	</head>
	<body class="bg-bg text-fg flex min-h-screen flex-col antialiased">
		<a
			href="#main-content"
			class="skip-link focus:bg-accent-strong focus:text-accent-contrast sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:text-sm focus:font-semibold"
		>
			Skip to content
		</a>
		<Masthead {...masthead} />
		<main id="main-content" class="flex-1" tabindex="-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>
