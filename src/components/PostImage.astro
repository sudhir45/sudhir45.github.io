---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PostFigure from './PostFigure.astro';

/**
 * Dark sources render with media="all" because dark is the site default; theme.ts switches
 * them to "not all" when a reader chooses the light theme.
 *
 * Post figure: optimized light and optional dark art in a numbered PostFigure, with a caption that
 * defaults to the alt text. The height always comes from the source's own aspect ratio, so the art
 * is never cropped; `width` sets the display width only.
 */
interface Props {
	light: ImageMetadata;
	dark?: ImageMetadata;
	alt: string;
	/** Display width in px. Figures narrower than 560px render centred at this size. */
	width: number;
	/** Caption text. Pass an empty string to omit the caption. */
	caption?: string;
	class?: string;
	style?: string;
	loading?: 'lazy' | 'eager';
}

const { light, dark, alt, width, caption = alt, class: className, loading = 'lazy' } = Astro.props;

const formats = ['avif', 'webp', 'png'] as const;
type Variants = Record<(typeof formats)[number], string>;

// Render at up to 1320px so the figure stays sharp at the full body width on dense screens.
const target = (image: ImageMetadata) => Math.min(image.width, Math.max(width, 1320));

const buildVariants = async (image: ImageMetadata): Promise<Variants> => {
	const w = target(image);
	const entries = await Promise.all(
		formats.map(async (format) => {
			// Width only: getImage keeps the source's aspect ratio instead of cropping to fit a box.
			const generated = await getImage({ src: image, width: w, format });
			return [format, generated.src] as const;
		})
	);
	return Object.fromEntries(entries) as Variants;
};

const lightSet = await buildVariants(light);
const darkSet = dark ? await buildVariants(dark) : null;
const height = Math.round((width * light.height) / light.width);
---

<PostFigure class:list={[{ 'is-narrow': width < 560 }, className]} caption={caption}>
	<picture>
		{
			darkSet && (
				<>
					<source
						srcset={darkSet.avif}
						type="image/avif"
						media="all"
						data-dark-source
					/>
					<source
						srcset={darkSet.webp}
						type="image/webp"
						media="all"
						data-dark-source
					/>
					<source srcset={darkSet.png} media="all" data-dark-source />
				</>
			)
		}
		<source srcset={lightSet.avif} type="image/avif" />
		<source srcset={lightSet.webp} type="image/webp" />
		<img
			src={lightSet.png}
			alt={alt}
			width={width}
			height={height}
			loading={loading}
			decoding="async"
		/>
	</picture>
</PostFigure>
