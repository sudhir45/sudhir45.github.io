---
interface Props {
	slug: string;
	title: string;
	slideCount: number;
}

const { slug, slideCount } = Astro.props;

const slides = Array.from({ length: slideCount }, (_, i) => ({
	number: i + 1,
	src: `/presentations/${slug}/slide-${i + 1}.jpg`
}));
---

<div class="presentation-viewer" data-slide-count={slideCount} data-slug={slug}>
	<!-- 2px amber slide progress, pinned to the top of the viewport like the reading view -->
	<div class="progress-bar-container">
		<div
			class="progress-bar"
			role="progressbar"
			aria-valuemin="1"
			aria-valuemax={slideCount}
			aria-valuenow="1"
		>
			<div class="progress-fill"></div>
		</div>
	</div>

	<div class="viewer-container group">
		<!-- The slide sits plainly on the paper with a hairline frame -->
		<div class="slide-container">
			<div class="slide-placeholder"></div>

			<div class="slide-loading">
				<div class="spinner"></div>
			</div>

			<img
				class="slide-image slide-image-a active"
				src={slides[0]?.src ?? ''}
				alt={`Slide 1 of ${slideCount}`}
				data-slides={JSON.stringify(slides)}
			/>
			<img class="slide-image slide-image-b" src={slides[0]?.src} alt="" />

		</div>

		<!-- Quiet text controls -->
		<div class="flex flex-wrap items-center justify-between gap-x-5 gap-y-2 px-0.5 py-4">
			<span class="meta-mono slide-counter whitespace-nowrap">
				<span class="slide-current">1</span><span class="slide-separator"> / </span><span
					class="slide-total">{slideCount}</span
				>
			</span>
			<div class="flex items-center gap-6 text-sm font-medium">
				<button
					class="prev-btn text-faint hover:text-fg transition-colors disabled:cursor-not-allowed disabled:opacity-40"
					aria-label="Previous slide"
				>
					← Previous
				</button>
				<button
					class="next-btn text-accent transition-opacity hover:opacity-70 disabled:cursor-not-allowed disabled:opacity-40"
					aria-label="Next slide"
				>
					Next →
				</button>
			</div>
			<div class="flex items-center gap-5 text-[13px] font-medium">
				<button
					class="grid-btn text-faint hover:text-fg transition-colors"
					aria-label="Slide grid overview"
					title="Slide grid (G)"
				>
					Grid
				</button>
				<button
					class="fullscreen-btn text-faint hover:text-fg transition-colors"
					aria-label="Toggle fullscreen"
					title="Fullscreen (F)"
				>
					<span class="fullscreen-expand">Expand</span>
					<span class="fullscreen-compress hidden">Close expanded view</span>
				</button>
			</div>
		</div>

		<!-- Thumbnails -->
		<div class="thumbnail-strip">
			{
				slides.map((slide) => (
					<button
						class="thumbnail-btn"
						data-slide-num={slide.number}
						aria-label={`Go to slide ${slide.number}`}
					>
						<img src={slide.src} alt={`Thumbnail ${slide.number}`} loading="lazy" />
					</button>
				))
			}
		</div>
	</div>

	<!-- Zoom: its own modal dialog, outside the slide so touch gestures never reach slide swipes -->
	<dialog class="zoom-overlay" aria-label="Zoomed slide">
		<img class="zoom-image" src={slides[0]?.src} alt="Zoomed slide" draggable="false" />
		<button class="zoom-close" aria-label="Close zoom">
			<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"
				></path>
			</svg>
		</button>
		<p class="zoom-hint">Pinch or scroll to zoom · drag to pan · Esc or tap outside to close</p>
	</dialog>

	<!-- Shortcuts modal (opened with ?) -->
	<dialog class="shortcuts-modal" aria-labelledby="shortcuts-title">
		<div class="shortcuts-backdrop"></div>
		<div class="shortcuts-content">
			<h3 id="shortcuts-title">Keyboard shortcuts</h3>
			<div class="shortcuts-grid">
				<div class="shortcut-row">
					<kbd>←</kbd>
					<kbd>→</kbd>
					<span>Navigate slides</span>
				</div>
				<div class="shortcut-row">
					<kbd>Home</kbd>
					<kbd>End</kbd>
					<span>First / last slide</span>
				</div>
				<div class="shortcut-row">
					<kbd>F</kbd>
					<span>Toggle fullscreen</span>
				</div>
				<div class="shortcut-row">
					<kbd>Z</kbd>
					<span>Zoom current slide</span>
				</div>
				<div class="shortcut-row">
					<kbd>G</kbd>
					<span>Grid overview</span>
				</div>
				<div class="shortcut-row">
					<kbd>Esc</kbd>
					<span>Exit fullscreen / zoom</span>
				</div>
				<div class="shortcut-row">
					<kbd>?</kbd>
					<span>Show this help</span>
				</div>
			</div>
			<button class="shortcuts-close">Got it</button>
		</div>
	</dialog>

	<!-- Grid overview modal -->
	<dialog class="grid-modal" aria-labelledby="grid-title">
		<div class="grid-backdrop"></div>
		<div class="grid-content">
			<div class="grid-header">
				<h3 id="grid-title">All slides</h3>
				<button class="grid-close" aria-label="Close slide overview">
					<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>
			</div>
			<div class="grid-list">
				{
					slides.map((slide) => (
						<button
							class="grid-slide-btn"
							data-grid-slide-num={slide.number}
							aria-label={`Open slide ${slide.number}`}
						>
							<img src={slide.src} alt={`Slide ${slide.number}`} loading="lazy" />
							<span class="grid-slide-number">Slide {slide.number}</span>
						</button>
					))
				}
			</div>
		</div>
	</dialog>

	<p class="slide-announcer sr-only" aria-live="polite" aria-atomic="true">
		Slide 1 of {slideCount}
	</p>

	<p class="viewer-hints meta-mono pt-3 text-center">
		<span class="hint-desktop"
			>← → navigate &nbsp;·&nbsp; F fullscreen &nbsp;·&nbsp; G grid &nbsp;·&nbsp; Z zoom</span
		>
		<span class="hint-mobile">Swipe to navigate &nbsp;·&nbsp; tap slide to zoom</span>
	</p>
</div>

<style>
	.presentation-viewer {
		--transition-ui: 0.2s ease;
	}

	/* Slide progress: 2px amber line at the very top of the viewport,
	   the same treatment as the reading view's scroll progress. */
	.progress-bar-container {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 60;
		height: 2px;
		pointer-events: none;
	}

	.progress-bar {
		height: 100%;
	}

	.progress-fill {
		height: 100%;
		width: 0;
		background: var(--accent);
		transition: width 0.3s ease;
	}

	.slide-container {
		position: relative;
		aspect-ratio: 16 / 9;
		border: 1px solid var(--frame);
		background: var(--surface-2);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}

	.slide-placeholder {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: center;
		filter: blur(20px);
		transform: scale(1.1);
		opacity: 0.35;
		transition: opacity 0.3s ease;
	}

	.slide-loading {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 10;
		opacity: 0;
		transition: opacity 0.2s ease;
		pointer-events: none;
	}

	.slide-loading.visible {
		opacity: 1;
	}

	.slide-loading.hidden {
		opacity: 0;
		pointer-events: none;
	}

	.spinner {
		width: 2.5rem;
		height: 2.5rem;
		border: 3px solid var(--line);
		border-top-color: var(--accent);
		border-radius: 50%;
		animation: spin 0.8s linear infinite;
	}

	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}

	.slide-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
		z-index: 5;
		opacity: 0;
		transition: opacity 0.3s ease;
		cursor: zoom-in;
		pointer-events: none;
	}

	.slide-image.active {
		opacity: 1;
		z-index: 6;
		pointer-events: auto;
	}

	/* Thumbnails: hairline frames on paper, current slide inked */
	.thumbnail-strip {
		display: flex;
		gap: 8px;
		padding: 2px 0;
		overflow-x: auto;
		scroll-behavior: smooth;
		scrollbar-width: thin;
		scrollbar-color: var(--line) transparent;
	}

	.thumbnail-btn {
		position: relative;
		flex: none;
		width: 88px;
		aspect-ratio: 16 / 9;
		padding: 0;
		border: 1px solid var(--line);
		background: var(--surface-2);
		opacity: 0.55;
		cursor: pointer;
		overflow: hidden;
		box-sizing: border-box;
		transition:
			opacity var(--transition-ui),
			border-color var(--transition-ui);
	}

	.thumbnail-btn img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.thumbnail-btn:hover {
		opacity: 0.85;
	}

	.thumbnail-btn.active {
		opacity: 1;
		border: 2px solid var(--line-strong);
	}

	/* Zoom overlay: paper lightbox, matching medium-zoom on posts */
	/* Overlays are native modal dialogs: the browser makes the page behind them inert,
	   keeps Tab inside, and closes them on Escape. These rules undo the UA dialog box. */
	dialog.zoom-overlay,
	dialog.shortcuts-modal,
	dialog.grid-modal {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		color: inherit;
		overflow: hidden;
	}

	dialog::backdrop {
		background: transparent;
	}

	.zoom-overlay {
		background: color-mix(in oklab, var(--bg) 96%, transparent) !important;
		cursor: grab;
		touch-action: none;
	}

	.zoom-overlay[open] {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.zoom-overlay.dragging {
		cursor: grabbing;
	}

	/* Scale 1 fits the whole slide on screen; zoom and pan are applied as a transform. */
	.zoom-image {
		max-width: 94vw;
		max-height: 86vh;
		width: auto;
		height: auto;
		transform-origin: center center;
		user-select: none;
		-webkit-user-select: none;
	}

	.zoom-close {
		position: absolute;
		top: 1.25rem;
		right: 1.25rem;
		padding: 0.6rem;
		background: var(--bg);
		border: 1px solid var(--line);
		border-radius: 50%;
		color: var(--muted);
		cursor: pointer;
		transition: color var(--transition-ui);
		z-index: 1;
	}

	.zoom-close:hover {
		color: var(--fg);
	}

	.zoom-hint {
		position: absolute;
		bottom: 1.5rem;
		left: 50%;
		transform: translateX(-50%);
		padding: 6px 12px;
		background: var(--bg);
		border: 1px solid var(--line);
		font-family: var(--font-code);
		font-size: 12px;
		font-weight: 500;
		color: var(--subtle);
		max-width: calc(100% - 32px);
		text-align: center;
		pointer-events: none;
	}

	/* Modals: plain paper panels, hairline borders, no glass */
	.shortcuts-modal[open] {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.shortcuts-backdrop {
		position: absolute;
		inset: 0;
		background: color-mix(in oklab, var(--fg) 32%, transparent);
	}

	.shortcuts-content {
		position: relative;
		width: 90%;
		max-width: 400px;
		padding: 1.5rem;
		background: var(--bg);
		border: 1px solid var(--line);
	}

	.shortcuts-content h3 {
		margin: 0 0 1.25rem;
		font-family: var(--font-display);
		font-size: 17px;
		font-weight: 500;
		letter-spacing: -0.01em;
		color: var(--fg);
	}

	.shortcuts-grid {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.shortcut-row {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.875rem;
		color: var(--muted);
	}

	.shortcut-row kbd {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 1.75rem;
		padding: 0.25rem 0.5rem;
		background: var(--surface-2);
		border: 1px solid var(--line);
		border-radius: 0.25rem;
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--fg);
	}

	.shortcut-row span {
		margin-left: auto;
	}

	.shortcuts-close {
		display: block;
		width: 100%;
		margin-top: 1.5rem;
		padding: 0.7rem;
		background: var(--fg);
		color: var(--bg);
		border: none;
		font-size: 0.875rem;
		font-weight: 500;
		cursor: pointer;
		transition: opacity var(--transition-ui);
	}

	.shortcuts-close:hover {
		opacity: 0.85;
	}

	.grid-modal[open] {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.grid-backdrop {
		position: absolute;
		inset: 0;
		background: color-mix(in oklab, var(--fg) 32%, transparent);
	}

	.grid-content {
		position: relative;
		width: min(1100px, 94vw);
		max-height: 85vh;
		overflow: hidden;
		background: var(--bg);
		border: 1px solid var(--line);
	}

	.grid-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1rem 1.25rem;
		border-bottom: 1px solid var(--line);
	}

	.grid-header h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 16px;
		font-weight: 500;
		letter-spacing: -0.01em;
		color: var(--fg);
	}

	.grid-close {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.5rem;
		border: none;
		background: transparent;
		color: var(--muted);
		cursor: pointer;
		transition: color var(--transition-ui);
	}

	.grid-close:hover {
		color: var(--fg);
	}

	.grid-list {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
		gap: 0.75rem;
		padding: 1rem;
		max-height: calc(85vh - 60px);
		overflow-y: auto;
	}

	.grid-slide-btn {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: 0;
		border: 1px solid var(--line);
		background: var(--surface-2);
		overflow: hidden;
		cursor: pointer;
		transition: border-color var(--transition-ui);
	}

	.grid-slide-btn img {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}

	.grid-slide-btn:hover {
		border-color: var(--faint);
	}

	.grid-slide-btn.active {
		border-color: var(--line-strong);
	}

	.grid-slide-number {
		padding: 0.3rem 0.5rem 0.5rem;
		font-family: var(--font-code);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--subtle);
		text-align: left;
	}

	/* Keyboard focus */
	.presentation-viewer button:focus-visible,
	.presentation-viewer dialog button:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.hint-mobile {
		display: none;
	}

	/* Fullscreen: paper, slide fills the space, controls stay quiet */
	.presentation-viewer.fullscreen {
		position: fixed;
		inset: 0;
		z-index: 50;
		background: var(--bg);
		padding: 20px 24px;
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}

	.presentation-viewer.fullscreen .viewer-container {
		flex: 1;
		display: flex;
		flex-direction: column;
		min-height: 0;
	}

	.presentation-viewer.fullscreen .slide-container {
		flex: 1;
		aspect-ratio: unset;
		min-height: 0;
	}

	.presentation-viewer.fullscreen .viewer-hints {
		display: none;
	}

	@media (max-width: 640px) {
		.hint-desktop {
			display: none;
		}

		.hint-mobile {
			display: inline;
		}

		.thumbnail-btn {
			width: 72px;
		}
	}
</style>

<script>
	import { isFull } from '@/motion/level';

	function setupPresentationViewers() {
		const viewers = document.querySelectorAll('.presentation-viewer');

		const documentListeners: Array<{ type: string; handler: EventListener }> = [];
		const windowListeners: Array<{ type: string; handler: EventListener }> = [];

		function addDocumentListener(type: string, handler: EventListener) {
			document.addEventListener(type, handler);
			documentListeners.push({ type, handler });
		}

		function addWindowListener(type: string, handler: EventListener) {
			window.addEventListener(type, handler);
			windowListeners.push({ type, handler });
		}

		viewers.forEach((viewerEl) => {
			const viewer = viewerEl as HTMLElement;

			if (viewer.dataset.initialized === 'true') return;
			viewer.dataset.initialized = 'true';

			const slideCount = parseInt(viewer.dataset.slideCount || '1', 10);
			const clampSlide = (value: number) => Math.max(1, Math.min(slideCount, value));

			const getSlideFromUrl = () => {
				const url = new URL(window.location.href);
				const raw = url.searchParams.get('slide');
				if (!raw) return 1;
				const parsed = parseInt(raw, 10);
				return Number.isNaN(parsed) ? 1 : clampSlide(parsed);
			};

			const setSlideInUrl = (slideNum: number) => {
				const url = new URL(window.location.href);
				if (slideNum <= 1) {
					url.searchParams.delete('slide');
				} else {
					url.searchParams.set('slide', String(slideNum));
				}
				window.history.replaceState(
					window.history.state,
					'',
					`${url.pathname}${url.search}${url.hash}`
				);
			};

			let currentSlide = getSlideFromUrl();

			const slideImageA = viewer.querySelector('.slide-image-a') as HTMLImageElement;
			const slideImageB = viewer.querySelector('.slide-image-b') as HTMLImageElement;
			let activeImage: HTMLImageElement = slideImageA;
			let inactiveImage: HTMLImageElement = slideImageB;

			const slideLoading = viewer.querySelector('.slide-loading') as HTMLElement;
			const slidePlaceholder = viewer.querySelector('.slide-placeholder') as HTMLElement;
			const slideCounter = viewer.querySelector('.slide-current') as HTMLElement;
			const prevBtn = viewer.querySelector('.prev-btn') as HTMLButtonElement;
			const nextBtn = viewer.querySelector('.next-btn') as HTMLButtonElement;
			const fullscreenBtn = viewer.querySelector('.fullscreen-btn') as HTMLButtonElement;
			const gridBtn = viewer.querySelector('.grid-btn') as HTMLButtonElement;
			const shortcutsBtn = viewer.querySelector('.shortcuts-btn') as HTMLButtonElement;
			const shortcutsModal = viewer.querySelector('.shortcuts-modal') as HTMLDialogElement;
			const shortcutsClose = viewer.querySelector('.shortcuts-close') as HTMLButtonElement;
			const shortcutsBackdrop = viewer.querySelector('.shortcuts-backdrop') as HTMLElement;
			const gridModal = viewer.querySelector('.grid-modal') as HTMLDialogElement;
			const gridClose = viewer.querySelector('.grid-close') as HTMLButtonElement;
			const gridBackdrop = viewer.querySelector('.grid-backdrop') as HTMLElement;
			const thumbnailBtns = viewer.querySelectorAll('.thumbnail-btn');
			const gridSlideBtns = viewer.querySelectorAll('.grid-slide-btn');
			const thumbnailStrip = viewer.querySelector('.thumbnail-strip') as HTMLElement;
			const progressFill = viewer.querySelector('.progress-fill') as HTMLElement;
			const progressIndicator = viewer.querySelector('.progress-bar') as HTMLElement;
			const progressBar = viewer.querySelector('.progress-bar-container') as HTMLElement;
			const slideAnnouncer = viewer.querySelector('.slide-announcer') as HTMLElement;
			const zoomBtn = viewer.querySelector('.zoom-btn') as HTMLButtonElement;
			const zoomOverlay = viewer.querySelector('.zoom-overlay') as HTMLDialogElement;
			const zoomImage = viewer.querySelector('.zoom-image') as HTMLImageElement;
			const zoomClose = viewer.querySelector('.zoom-close') as HTMLButtonElement;
			const slideContainer = viewer.querySelector('.slide-container') as HTMLElement;

			const slides = JSON.parse(slideImageA?.dataset.slides || '[]');

			viewer.style.setProperty('--slide-count', String(slideCount));

			function announceCurrentSlide() {
				if (slideAnnouncer) {
					slideAnnouncer.textContent = `Slide ${currentSlide} of ${slideCount}`;
				}
			}

			function updateProgress() {
				const percentage = (currentSlide / slideCount) * 100;
				progressFill.style.width = `${percentage}%`;
				progressIndicator.setAttribute('aria-valuenow', String(currentSlide));
				progressIndicator.setAttribute('aria-valuetext', `Slide ${currentSlide} of ${slideCount}`);
			}

			function updateNavButtons() {
				const isFirstSlide = currentSlide <= 1;
				const isLastSlide = currentSlide >= slideCount;

				prevBtn.disabled = isFirstSlide;
				nextBtn.disabled = isLastSlide;
				prevBtn.setAttribute('aria-disabled', String(isFirstSlide));
				nextBtn.setAttribute('aria-disabled', String(isLastSlide));
			}

			function updateSlideSelectors(scrollIntoView = true) {
				thumbnailBtns.forEach((btn) => {
					const btnNum = parseInt((btn as HTMLElement).dataset.slideNum || '0', 10);
					btn.classList.toggle('active', btnNum === currentSlide);

					if (scrollIntoView && btnNum === currentSlide && thumbnailStrip) {
						(btn as HTMLElement).scrollIntoView({
							behavior: isFull() ? 'smooth' : 'instant',
							block: 'nearest',
							inline: 'center'
						});
					}
				});

				gridSlideBtns.forEach((btn) => {
					const btnNum = parseInt((btn as HTMLElement).dataset.gridSlideNum || '0', 10);
					btn.classList.toggle('active', btnNum === currentSlide);
				});
			}

			function syncUiState(options: { announce?: boolean; scrollIntoView?: boolean } = {}) {
				const { announce = true, scrollIntoView = true } = options;
				slideCounter.textContent = String(currentSlide);
				updateProgress();
				updateNavButtons();
				updateSlideSelectors(scrollIntoView);
				if (announce) {
					announceCurrentSlide();
				}
			}

			// Modal dialogs: showModal() makes the rest of the page inert and keeps Tab inside.
			// Focus moves to `focusTarget` and returns to the opener when the dialog closes.
			const dialogs = [zoomOverlay, gridModal, shortcutsModal];
			const openers = new WeakMap<HTMLDialogElement, HTMLElement>();
			const anyDialogOpen = () => dialogs.some((dialog) => dialog.open);

			function openDialog(dialog: HTMLDialogElement, focusTarget?: HTMLElement | null) {
				if (dialog.open) return;
				dialogs.forEach((other) => other.open && other.close());
				const opener = document.activeElement;
				if (opener instanceof HTMLElement && opener !== document.body) openers.set(dialog, opener);
				dialog.showModal();
				document.body.style.overflow = 'hidden';
				focusTarget?.focus();
			}

			dialogs.forEach((dialog) => {
				dialog.addEventListener('close', () => {
					if (!anyDialogOpen()) document.body.style.overflow = '';
					const opener = openers.get(dialog);
					openers.delete(dialog);
					if (opener?.isConnected) opener.focus();
				});
			});

			function openGrid() {
				const active = viewer.querySelector<HTMLElement>(
					`.grid-slide-btn[data-grid-slide-num="${currentSlide}"]`
				);
				openDialog(gridModal, active ?? gridClose);
				active?.scrollIntoView({ block: 'nearest', behavior: 'instant' });
			}

			function closeGrid() {
				gridModal.close();
			}

			function openShortcuts() {
				openDialog(shortcutsModal, shortcutsClose);
			}

			function closeShortcuts() {
				shortcutsModal.close();
			}

			function updateSlide(
				num: number,
				options: { updateUrl?: boolean; announce?: boolean; scrollIntoView?: boolean } = {}
			) {
				const { updateUrl = true, announce = true, scrollIntoView = true } = options;
				const targetSlide = clampSlide(num);

				if (targetSlide === currentSlide) {
					if (updateUrl) setSlideInUrl(targetSlide);
					syncUiState({ announce: false, scrollIntoView });
					return;
				}

				currentSlide = targetSlide;
				const slide = slides[targetSlide - 1];
				if (!slide) {
					if (updateUrl) setSlideInUrl(currentSlide);
					syncUiState({ announce, scrollIntoView });
					return;
				}

				if (slidePlaceholder) {
					slidePlaceholder.style.backgroundImage = `url(${slide.src})`;
				}

				let spinnerTimeout: ReturnType<typeof setTimeout> | null = setTimeout(() => {
					slideLoading.classList.add('visible');
				}, 300);

				inactiveImage.onload = () => {
					if (spinnerTimeout) {
						clearTimeout(spinnerTimeout);
						spinnerTimeout = null;
					}
					slideLoading.classList.remove('visible');
					slideLoading.classList.add('hidden');

					activeImage.classList.remove('active');
					inactiveImage.classList.add('active');

					const temp = activeImage;
					activeImage = inactiveImage;
					inactiveImage = temp;
				};

				inactiveImage.onerror = () => {
					if (spinnerTimeout) {
						clearTimeout(spinnerTimeout);
						spinnerTimeout = null;
					}
					slideLoading.classList.remove('visible');
					slideLoading.classList.add('hidden');
				};

				inactiveImage.src = slide.src;
				inactiveImage.alt = `Slide ${targetSlide} of ${slideCount}`;

				if (updateUrl) setSlideInUrl(currentSlide);
				syncUiState({ announce, scrollIntoView });
			}

			const initialSlide = clampSlide(currentSlide);
			const initialSlideData = slides[initialSlide - 1];
			currentSlide = initialSlide;
			slideLoading.classList.add('hidden');
			if (initialSlideData) {
				slideImageA.src = initialSlideData.src;
				slideImageA.alt = `Slide ${initialSlide} of ${slideCount}`;
			}
			if (slidePlaceholder && slideImageA.src) {
				slidePlaceholder.style.backgroundImage = `url(${slideImageA.src})`;
			}
			progressIndicator.setAttribute('aria-label', 'Slide progress');
			syncUiState({ announce: false, scrollIntoView: false });
			setSlideInUrl(currentSlide);

			prevBtn?.addEventListener('click', () => updateSlide(currentSlide - 1));
			nextBtn?.addEventListener('click', () => updateSlide(currentSlide + 1));

			thumbnailBtns.forEach((btn) => {
				btn.addEventListener('click', () => {
					const num = parseInt((btn as HTMLElement).dataset.slideNum || '1', 10);
					updateSlide(num);
				});
			});

			gridSlideBtns.forEach((btn) => {
				btn.addEventListener('click', () => {
					const num = parseInt((btn as HTMLElement).dataset.gridSlideNum || '1', 10);
					closeGrid();
					updateSlide(num);
				});
			});

			progressBar?.addEventListener('click', (e) => {
				const rect = progressBar.getBoundingClientRect();
				const percent = (e.clientX - rect.left) / rect.width;
				const targetSlide = Math.max(1, Math.min(slideCount, Math.ceil(percent * slideCount)));
				updateSlide(targetSlide);
			});

			let touchStartX = 0;
			let touchStartY = 0;
			let isSwiping = false;

			slideContainer?.addEventListener(
				'touchstart',
				(e) => {
					const touch = e.touches[0];
					if (!touch || e.touches.length > 1 || anyDialogOpen()) return;
					touchStartX = touch.clientX;
					touchStartY = touch.clientY;
					isSwiping = true;
				},
				{ passive: true }
			);

			slideContainer?.addEventListener(
				'touchmove',
				(e) => {
					if (!isSwiping) return;
					const touch = e.touches[0];
					if (!touch) return;
					const deltaY = Math.abs(touch.clientY - touchStartY);

					if (deltaY > 30) {
						isSwiping = false;
					}
				},
				{ passive: true }
			);

			slideContainer?.addEventListener('touchend', (e) => {
				if (!isSwiping || anyDialogOpen()) return;
				const touch = e.changedTouches[0];
				if (!touch) return;
				const touchEndX = touch.clientX;
				const deltaX = touchEndX - touchStartX;

				if (Math.abs(deltaX) > 50) {
					if (deltaX < 0) {
						updateSlide(currentSlide + 1);
					} else {
						updateSlide(currentSlide - 1);
					}
				}
				isSwiping = false;
			});

			// Zoom: scale 1 fits the slide to the screen. One pointer pans, two pointers pinch.
			const MIN_ZOOM = 1;
			const MAX_ZOOM = 5;
			let zoomScale = 1;
			let zoomPosX = 0;
			let zoomPosY = 0;
			const pointers = new Map<number, { x: number; y: number }>();
			let panStart = { x: 0, y: 0, posX: 0, posY: 0 };
			let pinchStart = { distance: 0, scale: 1 };
			let gestureMoved = false;

			function applyZoom() {
				// Keep the scaled slide's edges reachable without letting it drift off screen.
				const maxX = Math.max(0, (zoomImage.offsetWidth * zoomScale - window.innerWidth) / 2);
				const maxY = Math.max(0, (zoomImage.offsetHeight * zoomScale - window.innerHeight) / 2);
				zoomPosX = Math.max(-maxX, Math.min(maxX, zoomPosX));
				zoomPosY = Math.max(-maxY, Math.min(maxY, zoomPosY));
				zoomImage.style.transform = `translate(${zoomPosX}px, ${zoomPosY}px) scale(${zoomScale})`;
			}

			function setZoom(scale: number) {
				zoomScale = Math.max(MIN_ZOOM, Math.min(MAX_ZOOM, scale));
				applyZoom();
			}

			function openZoom() {
				zoomScale = 1;
				zoomPosX = 0;
				zoomPosY = 0;
				pointers.clear();
				zoomImage.src = activeImage.src;
				zoomImage.alt = `Slide ${currentSlide} of ${slideCount}, zoomed`;
				openDialog(zoomOverlay, zoomClose);
				applyZoom();
			}

			function closeZoom() {
				zoomOverlay.close();
			}

			zoomBtn?.addEventListener('click', openZoom);
			slideImageA?.addEventListener('click', openZoom);
			slideImageB?.addEventListener('click', openZoom);
			zoomClose?.addEventListener('click', closeZoom);

			zoomOverlay?.addEventListener('click', (e) => {
				if (e.target === zoomOverlay && !gestureMoved) closeZoom();
			});

			zoomOverlay?.addEventListener(
				'wheel',
				(e) => {
					e.preventDefault();
					setZoom(zoomScale + (e.deltaY > 0 ? -0.2 : 0.2));
				},
				{ passive: false }
			);

			zoomImage?.addEventListener('dblclick', () => {
				zoomPosX = 0;
				zoomPosY = 0;
				setZoom(zoomScale > 1 ? 1 : 2.5);
			});

			const pinchDistance = () => {
				const [a, b] = [...pointers.values()];
				return a && b ? Math.hypot(a.x - b.x, a.y - b.y) : 0;
			};

			zoomOverlay?.addEventListener('pointerdown', (e) => {
				if ((e.target as Element).closest('.zoom-close')) return;
				zoomOverlay.setPointerCapture(e.pointerId);
				pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
				if (pointers.size === 1) {
					gestureMoved = false;
					panStart = { x: e.clientX, y: e.clientY, posX: zoomPosX, posY: zoomPosY };
					zoomOverlay.classList.add('dragging');
				} else if (pointers.size === 2) {
					pinchStart = { distance: pinchDistance(), scale: zoomScale };
				}
			});

			zoomOverlay?.addEventListener('pointermove', (e) => {
				if (!pointers.has(e.pointerId)) return;
				pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
				if (pointers.size >= 2 && pinchStart.distance > 0) {
					gestureMoved = true;
					setZoom(pinchStart.scale * (pinchDistance() / pinchStart.distance));
				} else if (pointers.size === 1) {
					const dx = e.clientX - panStart.x;
					const dy = e.clientY - panStart.y;
					if (Math.abs(dx) + Math.abs(dy) > 4) gestureMoved = true;
					zoomPosX = panStart.posX + dx;
					zoomPosY = panStart.posY + dy;
					applyZoom();
				}
			});

			const endPointer = (e: PointerEvent) => {
				pointers.delete(e.pointerId);
				if (pointers.size === 1) {
					// Continue panning from the remaining finger after a pinch.
					const [rest] = [...pointers.values()];
					if (rest) panStart = { x: rest.x, y: rest.y, posX: zoomPosX, posY: zoomPosY };
				}
				if (pointers.size === 0) zoomOverlay.classList.remove('dragging');
			};
			zoomOverlay?.addEventListener('pointerup', endPointer);
			zoomOverlay?.addEventListener('pointercancel', endPointer);

			addWindowListener('popstate', (() => {
				const targetSlide = getSlideFromUrl();
				updateSlide(targetSlide, { updateUrl: false, announce: false, scrollIntoView: false });
			}) as EventListener);

			addDocumentListener('keydown', ((e: KeyboardEvent) => {
				// Leave browser and OS shortcuts alone (Ctrl+F find, Ctrl+Z undo, Alt+Left back).
				if (e.ctrlKey || e.metaKey || e.altKey) return;
				if (
					e.target instanceof HTMLInputElement ||
					e.target instanceof HTMLTextAreaElement ||
					(e.target as HTMLElement)?.isContentEditable ||
					e.target instanceof HTMLSelectElement ||
					document.querySelector('#search-modal:not(.hidden)')
				) {
					return;
				}

				if (anyDialogOpen()) {
					const key = e.key.toLowerCase();
					if (key === 'z' && zoomOverlay.open) closeZoom();
					else if (key === 'g' && gridModal.open) closeGrid();
					else if (key === '?' && shortcutsModal.open) closeShortcuts();
					else return;
					e.preventDefault();
					return;
				}

				switch (e.key) {
					case 'ArrowLeft':
						e.preventDefault();
						updateSlide(currentSlide - 1);
						break;
					case 'ArrowRight':
						e.preventDefault();
						updateSlide(currentSlide + 1);
						break;
					case 'Home':
						e.preventDefault();
						updateSlide(1);
						break;
					case 'End':
						e.preventDefault();
						updateSlide(slideCount);
						break;
					case 'f':
					case 'F':
						e.preventDefault();
						fullscreenBtn?.click();
						break;
					case 'z':
					case 'Z':
						e.preventDefault();
						openZoom();
						break;
					case 'g':
					case 'G':
						e.preventDefault();
						openGrid();
						break;
					case '?':
						e.preventDefault();
						openShortcuts();
						break;
					case 'Escape':
						// Open dialogs close natively on Escape; this only leaves the expanded view.
						if (viewer.classList.contains('fullscreen')) {
							viewer.classList.remove('fullscreen');
							fullscreenBtn?.querySelector('.fullscreen-expand')?.classList.remove('hidden');
							fullscreenBtn?.querySelector('.fullscreen-compress')?.classList.add('hidden');
						}
						break;
				}
			}) as EventListener);

			shortcutsBtn?.addEventListener('click', openShortcuts);
			shortcutsClose?.addEventListener('click', closeShortcuts);
			shortcutsBackdrop?.addEventListener('click', closeShortcuts);

			gridBtn?.addEventListener('click', openGrid);
			gridClose?.addEventListener('click', closeGrid);
			gridBackdrop?.addEventListener('click', closeGrid);

			fullscreenBtn?.addEventListener('click', () => {
				viewer.classList.toggle('fullscreen');
				const isFullscreen = viewer.classList.contains('fullscreen');
				fullscreenBtn.querySelector('.fullscreen-expand')?.classList.toggle('hidden', isFullscreen);
				fullscreenBtn
					.querySelector('.fullscreen-compress')
					?.classList.toggle('hidden', !isFullscreen);
			});
		});

		document.addEventListener(
			'astro:before-swap',
			() => {
				documentListeners.forEach(({ type, handler }) => {
					document.removeEventListener(type, handler);
				});
				windowListeners.forEach(({ type, handler }) => {
					window.removeEventListener(type, handler);
				});
				documentListeners.length = 0;
				windowListeners.length = 0;

				document.body.style.overflow = '';
				viewers.forEach((viewerEl) => {
					(viewerEl as HTMLElement).dataset.initialized = '';
				});
			},
			{ once: true }
		);
	}

	document.addEventListener('astro:page-load', setupPresentationViewers);
</script>
