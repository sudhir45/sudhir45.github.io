<div id="search-modal" class="search-modal hidden" role="dialog" aria-modal="true" aria-labelledby="search-title">
	<div class="search-panel">
		<div class="search-head">
			<h2 id="search-title" class="sc">Search the writing</h2>
			<button data-search-close class="search-close ui" aria-label="Close search">
				Close <span aria-hidden="true">×</span>
			</button>
		</div>
		<div class="search-field">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
				<path stroke-linecap="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
			</svg>
			<input
				id="search-input"
				placeholder="Search writing"
				type="search"
				autocomplete="off"
				aria-label="Search writing"
				aria-controls="search-results"
				aria-autocomplete="list"
			/>
		</div>
		<div class="results-scroll">
			<span class="search-highlight" data-search-highlight aria-hidden="true"></span>
			<ul id="search-results" role="listbox" aria-label="Search results"></ul>
		</div>
		<p id="search-status" class="visually-hidden" aria-live="polite"></p>
		<div class="search-foot ui">
			<span><kbd>↑↓</kbd> navigate · <kbd>Enter</kbd> open</span>
			<span><kbd>Esc</kbd> close</span>
		</div>
	</div>
</div>

<style>
	.search-modal {
		position: fixed;
		inset: 0;
		z-index: 70;
		overflow-y: auto;
		padding: clamp(12px, 6vh, 80px) 16px 40px;
		background: color-mix(in oklab, var(--fg) 28%, transparent);
	}
	.search-modal.hidden {
		display: none;
	}
	.search-panel {
		width: 100%;
		max-width: 760px;
		margin-inline: auto;
		border-top: 2px solid var(--fg);
		background: var(--bg);
		box-shadow: 0 1px 0 var(--line);
	}
	:global(html[data-motion='full']) .search-modal:not(.hidden) .search-panel {
		animation: folio-unmask var(--dur-micro) var(--ease-out) both;
	}
	.search-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 12px 24px 0;
	}
	.search-head h2 {
		font-family: var(--font-ui);
		color: var(--muted);
	}
	.search-close {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		min-height: 44px;
		padding: 0;
		border: 0;
		background: none;
		font-size: var(--text-meta);
		color: var(--muted);
	}
	.search-close:hover {
		color: var(--fg);
	}
	.search-close span {
		font-size: var(--text-body);
	}
	.search-field {
		position: relative;
		margin: 4px 24px 0;
		border-bottom: 1px solid var(--fg);
	}
	.search-field svg {
		position: absolute;
		left: 0;
		top: 50%;
		width: 22px;
		height: 22px;
		color: var(--muted);
		transform: translateY(-50%);
	}
	input {
		width: 100%;
		height: 64px;
		padding: 0 0 0 36px;
		border: 0;
		background: transparent;
		font: 400 clamp(1.375rem, 2.4vw, 1.75rem) var(--font-reading);
		color: var(--fg);
		outline: none;
	}
	input::-webkit-search-cancel-button {
		appearance: none;
	}
	input::placeholder {
		font-style: italic;
		color: var(--muted);
	}
	.search-field:focus-within {
		border-bottom-color: var(--accent);
	}
	.results-scroll {
		position: relative;
		max-height: min(60dvh, 34rem);
		overflow-y: auto;
		padding: 8px 0;
	}
	.search-highlight {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 0;
		border-left: 2px solid var(--accent);
		background: var(--surface-2);
		opacity: 0;
		transition:
			transform var(--dur-move) var(--ease-rise),
			height var(--dur-move) var(--ease-rise);
	}
	:global(html:not([data-motion='full'])) .search-highlight {
		transition: none;
	}
	ul {
		position: relative;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	ul :global(.search-label) {
		padding: 8px 24px;
		font: 500 var(--text-smallcaps) var(--font-ui);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
	}
	ul :global(.search-result a) {
		display: block;
		padding: 14px 24px;
		border-top: 1px solid var(--line);
	}
	ul :global(.search-result:first-of-type a) {
		border-top: 0;
	}
	ul :global(.search-title) {
		display: block;
		font: 400 clamp(1.1875rem, 1.8vw, 1.4375rem) / 1.25 var(--font-reading);
		letter-spacing: -0.01em;
		color: var(--fg);
	}
	ul :global(.search-result[aria-selected='true'] .search-title) {
		font-style: italic;
	}
	ul :global(.search-description) {
		display: -webkit-box;
		margin-top: 4px;
		overflow: hidden;
		font: 400 var(--text-ui) / 1.5 var(--font-ui);
		color: var(--body-ink);
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
	}
	ul :global(.search-meta) {
		display: block;
		margin-top: 6px;
		font: 400 var(--text-xs) var(--font-ui);
		color: var(--muted);
	}
	ul :global(.search-message) {
		padding: 36px 24px;
		text-align: center;
		color: var(--muted);
	}
	ul :global(.search-message strong) {
		display: block;
		font: 400 22px var(--font-reading);
		font-style: italic;
		color: var(--fg);
	}
	ul :global(.search-message button) {
		margin-top: 16px;
	}
	:global(html[data-motion='full']) ul :global(.search-result) {
		animation: folio-rise-in var(--dur-move) var(--ease-rise) both;
		animation-delay: calc(var(--dur-micro) + var(--i, 0) * 30ms);
	}
	.search-foot {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		padding: 12px 24px;
		border-top: 1px solid var(--line);
		font-size: var(--text-xs);
		color: var(--muted);
	}
	kbd {
		font: 500 11px var(--font-ui);
		color: var(--fg);
	}
	@keyframes folio-rise-in {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
	}
	@media (max-width: 767px) {
		.search-modal {
			padding: 0;
		}
		.search-panel {
			min-height: 100dvh;
		}
		.search-head,
		ul :global(.search-result a),
		ul :global(.search-label) {
			padding-inline: 16px;
		}
		.search-field {
			margin-inline: 16px;
		}
		.results-scroll {
			max-height: none;
		}
		.search-foot {
			display: none;
		}
	}
</style>

<script>
	import { longDate } from '@/utils/editorial';

	interface SearchPost {
		slug: string;
		url?: string;
		title: string;
		description: string;
		tags: string[];
		primaryTopic: string;
		pubDate: string;
		minutesRead: string;
	}

	const SEARCH_STATE_KEY = '__fortmatrixSearchState';
	const SEARCH_BOOTSTRAP_KEY = '__fortmatrixSearchBootstrap';

	function clearSearchState() {
		const state = (window as any)[SEARCH_STATE_KEY];
		state?.cleanup?.();
		(window as any)[SEARCH_STATE_KEY] = null;
	}

	function setupSearch() {
		clearSearchState();
		const modal = document.getElementById('search-modal')!;
		const triggers = Array.from(document.querySelectorAll<HTMLElement>('[data-search-trigger]'));
		const closeButton = modal.querySelector<HTMLElement>('[data-search-close]')!;
		const input = document.getElementById('search-input') as HTMLInputElement;
		const list = document.getElementById('search-results')!;
		const status = document.getElementById('search-status')!;
		const highlight = modal.querySelector<HTMLElement>('[data-search-highlight]');
		if (!modal || !closeButton || !input || !list || !status || triggers.length === 0) return;

		let fuse: any = null;
		let posts: SearchPost[] = [];
		let loading: Promise<void> | null = null;
		let pendingQuery = '';
		let selectedIndex = -1;
		let links: HTMLAnchorElement[] = [];
		let lastFocused: HTMLElement | null = null;

		const announce = (message: string) => (status.textContent = message);
		const setExpanded = (value: boolean) =>
			triggers.forEach((trigger) => trigger.setAttribute('aria-expanded', String(value)));
		const clearResults = () => {
			list.replaceChildren();
			if (highlight) highlight.style.opacity = '0';
			links = [];
			selectedIndex = -1;
			input.removeAttribute('aria-activedescendant');
		};

		function renderMessage(title: string, detail: string, retry = false) {
			clearResults();
			const item = document.createElement('li');
			item.className = 'search-message';
			item.setAttribute('role', 'presentation');
			const heading = document.createElement('strong');
			heading.textContent = title;
			const copy = document.createElement('p');
			copy.className = 'ui';
			copy.textContent = detail;
			item.append(heading, copy);
			if (retry) {
				const button = document.createElement('button');
				button.type = 'button';
				button.className = 'btn-line';
				button.textContent = 'Try again';
				button.addEventListener('click', () => void initSearch(true));
				item.append(button);
			}
			list.append(item);
			announce(`${title}. ${detail}`);
		}

		function select(index: number, scroll = false) {
			if (links.length === 0) return;
			selectedIndex = (index + links.length) % links.length;
			links.forEach((link, current) => {
				link.parentElement?.setAttribute('aria-selected', String(current === selectedIndex));
			});
			const option = links[selectedIndex]?.parentElement;
			// One highlight bar slides between results.
			if (option && highlight) {
				highlight.style.opacity = '1';
				highlight.style.height = `${option.offsetHeight}px`;
				highlight.style.transform = `translateY(${option.offsetTop}px)`;
			}
			if (option) input.setAttribute('aria-activedescendant', option.id);
			if (scroll) option?.scrollIntoView({ block: 'nearest' });
		}

		function makeResult(item: SearchPost, index: number) {
			const li = document.createElement('li');
			li.id = `search-result-${index}`;
			li.className = 'search-result';
			li.style.setProperty('--i', String(index));
			li.setAttribute('role', 'option');
			li.setAttribute('aria-selected', 'false');
			const link = document.createElement('a');
			link.href = item.url ?? item.slug;

			const title = document.createElement('span');
			title.dataset.resultTitle = '';
			title.className = 'search-title';
			title.textContent = item.title;
			const description = document.createElement('span');
			description.className = 'search-description';
			description.textContent = item.description;
			const meta = document.createElement('span');
			meta.className = 'search-meta';
			const date = longDate(item.pubDate);
			meta.textContent = [item.primaryTopic, date, item.minutesRead].filter(Boolean).join(' · ');
			link.append(title, description, meta);
			link.addEventListener('mouseenter', () => select(index));
			link.addEventListener('focus', () => select(index));
			li.append(link);
			return { li, link };
		}

		function renderPosts(items: SearchPost[], heading: string) {
			clearResults();
			const label = document.createElement('li');
			label.className = 'search-label';
			label.setAttribute('role', 'presentation');
			label.textContent = heading;
			list.append(label);
			items.slice(0, 8).forEach((item, index) => {
				const result = makeResult(item, index);
				links.push(result.link);
				list.append(result.li);
			});
			if (links.length) select(0);
			announce(`${links.length} ${links.length === 1 ? 'result' : 'results'} available.`);
		}

		function showSuggestions() {
			if (posts.length) renderPosts(posts, 'Suggested writing');
			else
				renderMessage(
					'No writing yet',
					'Published posts will appear here when they are available.'
				);
		}

		function runSearch(query: string) {
			const matches = fuse
				.search(query)
				.slice(0, 8)
				.map((result: any) => result.item as SearchPost);
			if (matches.length) renderPosts(matches, 'Search results');
			else
				renderMessage('No matching writing', 'Try a broader phrase or browse the topic directory.');
		}

		async function initSearch(force = false) {
			if (fuse && !force) {
				pendingQuery ? runSearch(pendingQuery) : showSuggestions();
				return;
			}
			if (loading) return loading;
			fuse = null;
			posts = [];
			renderMessage('Loading writing', 'Preparing the search index.');
			loading = (async () => {
				const [{ default: Fuse }, response] = await Promise.all([
					import('fuse.js'),
					fetch('/search.json')
				]);
				if (!response.ok) throw new Error(`Search index returned ${response.status}`);
				posts = (await response.json()) as SearchPost[];
				fuse = new Fuse(posts, {
					keys: [
						{ name: 'title', weight: 1 },
						{ name: 'description', weight: 0.7 },
						{ name: 'tags', weight: 0.5 }
					],
					includeScore: true,
					threshold: 0.3
				});
				pendingQuery ? runSearch(pendingQuery) : showSuggestions();
			})()
				.catch((error) => {
					console.error('Failed to load search index', error);
					renderMessage(
						'Search is unavailable',
						'The index could not be loaded. Check your connection and try again.',
						true
					);
				})
				.finally(() => (loading = null));
			return loading;
		}

		function openModal() {
			if (modal.classList.contains('hidden'))
				lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
			const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-nav]');
			if (menu?.open) {
				lastFocused = menu.querySelector('summary');
				menu.open = false;
			}
			modal.classList.remove('hidden');
			setExpanded(true);
			document.body.style.overflow = 'hidden';
			input.focus();
			pendingQuery = input.value.trim();
			void initSearch();
		}

		function closeModal(restoreFocus = true) {
			modal.classList.add('hidden');
			setExpanded(false);
			input.value = '';
			pendingQuery = '';
			clearResults();
			document.body.style.overflow = '';
			if (restoreFocus) lastFocused?.focus();
			lastFocused = null;
		}

		const onTrigger = (event: Event) => {
			event.preventDefault();
			openModal();
		};
		const onClose = () => closeModal();
		const onInput = () => {
			pendingQuery = input.value.trim();
			if (fuse) pendingQuery ? runSearch(pendingQuery) : showSuggestions();
			else void initSearch();
		};
		const onBackdrop = (event: MouseEvent) => {
			if (event.target === modal) closeModal();
		};
		const onKeydown = (event: KeyboardEvent) => {
			const open = !modal.classList.contains('hidden');
			if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
				event.preventDefault();
				openModal();
				return;
			}
			const target = event.target as HTMLElement | null;
			const typing = target?.closest('input, textarea, select, [contenteditable="true"]');
			if (!open && event.key === '/' && !typing && !event.ctrlKey && !event.metaKey) {
				event.preventDefault();
				openModal();
				return;
			}
			if (!open) return;
			if (event.key === 'Escape') {
				event.preventDefault();
				closeModal();
			} else if (event.key === 'ArrowDown') {
				event.preventDefault();
				select(selectedIndex + 1, true);
			} else if (event.key === 'ArrowUp') {
				event.preventDefault();
				select(selectedIndex - 1, true);
			} else if (event.key === 'Enter' && document.activeElement === input && selectedIndex >= 0) {
				event.preventDefault();
				links[selectedIndex]?.click();
			} else if (event.key === 'Tab') {
				const focusables = Array.from(
					modal.querySelectorAll<HTMLElement>('input, a[href], button:not([disabled])')
				);
				const first = focusables[0];
				const last = focusables.at(-1);
				if (event.shiftKey && document.activeElement === first && last) {
					event.preventDefault();
					last.focus();
				} else if (!event.shiftKey && document.activeElement === last && first) {
					event.preventDefault();
					first.focus();
				}
			}
		};

		triggers.forEach((trigger) => trigger.addEventListener('click', onTrigger));
		closeButton.addEventListener('click', onClose);
		input.addEventListener('input', onInput);
		modal.addEventListener('click', onBackdrop);
		document.addEventListener('keydown', onKeydown);

		(window as any)[SEARCH_STATE_KEY] = {
			cleanup: () => {
				triggers.forEach((trigger) => trigger.removeEventListener('click', onTrigger));
				closeButton.removeEventListener('click', onClose);
				input.removeEventListener('input', onInput);
				modal.removeEventListener('click', onBackdrop);
				document.removeEventListener('keydown', onKeydown);
				if (!modal.classList.contains('hidden')) closeModal(false);
				document.body.style.overflow = '';
			}
		};
	}

	if (!(window as any)[SEARCH_BOOTSTRAP_KEY]) {
		document.addEventListener('astro:page-load', setupSearch);
		document.addEventListener('astro:before-swap', clearSearchState);
		(window as any)[SEARCH_BOOTSTRAP_KEY] = true;
	}
	setupSearch();
</script>
