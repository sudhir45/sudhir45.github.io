---
/**
 * MDX pull quote. Floats into the right margin from 1100px and sits inline below that.
 * Usage: <PullQuote>Each workaround creates a path the original design did not consider.</PullQuote>
 */
---

<aside class="pull-quote" data-draw-rule aria-label="Pull quote">
	<span class="pull-rule" data-draw="y" aria-hidden="true"></span>
	<p data-slide style="--delay:100ms">"<slot />"</p>
</aside>
