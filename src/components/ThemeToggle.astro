<button
	type="button"
	class="theme-toggle"
	data-theme-toggle
	aria-label="Switch to dark theme"
	title="Switch to dark theme"
	aria-pressed="false"
>
	<svg
		class="theme-moon"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1.5"
		aria-hidden="true"><path d="M20.7 13A9 9 0 0 1 11 3.3 9 9 0 1 0 20.7 13Z"></path></svg
	>
	<svg
		class="theme-sun"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1.5"
		aria-hidden="true"
		><circle cx="12" cy="12" r="4"></circle><path
			d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"></path></svg
	>
</button>
