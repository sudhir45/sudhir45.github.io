---
import { Image } from 'astro:assets';
import blossoms from '@/assets/images/almond-blossom.jpg';
import { SOCIALS } from '@/utils/AppConfig';
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-layout">
		<div class="footer-art" aria-hidden="true">
			<Image
				src={blossoms}
				alt=""
				widths={[320, 640, 960, 1280]}
				sizes="100vw"
				format="webp"
				quality={80}
				loading="lazy"
				decoding="async"
			/>
		</div>
		<div class="shell">
			<div class="footer">
				<p>© {year} Sudhir · Based in India</p><nav class="footer-nav" aria-label="Footer">
					{
						SOCIALS.map((social) => (
							<a
								href={social.url}
								target={social.url.startsWith('http') ? '_blank' : undefined}
								rel={social.url.startsWith('http') ? 'noopener noreferrer' : undefined}
							>
								{social.name}
							</a>
						))
					}
					<a href="/tags">Topics</a><a href="/rss.xml">RSS</a><a href="/imprint">Imprint</a>
				</nav>
			</div>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 28px;
		width: 100%;
	}
	.footer-art {
		width: 100%;
		height: clamp(100px, 13vw, 180px);
		overflow: clip;
		border-block: 1px solid var(--line);
	}
	.footer-art img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 45%;
	}
	:global(.dark) .footer-art img {
		filter: brightness(0.78) saturate(0.85);
	}
	.footer {
		border: 0;
	}
</style>
