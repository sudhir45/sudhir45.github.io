	<rect class="zn" x="4" y="104" width="176" height="100" rx="4"/><rect class="bgm" x="12" y="108" width="50.6" height="12" rx="2"/><text class="lb" x="16" y="117.4">Public</text>
	<rect class="zn" x="186" y="104" width="150" height="100" rx="4"/><rect class="bgm" x="194" y="108" width="79.0" height="12" rx="2"/><text class="lb" x="198" y="117.4">Management</text>
	<rect class="zn" x="4" y="228" width="176" height="220" rx="4"/><rect class="bgm" x="12" y="232" width="57.7" height="12" rx="2"/><text class="lb" x="16" y="241.4">Private</text>
	<path class="ar" d="M84,92 V136" marker-end={`url(#${uid}-compact-arrow)`}/>
	<path class="ar" d="M310,92 V136" marker-end={`url(#${uid}-compact-arrow)`}/>
	<path class="ar" d="M84,188 V260" marker-end={`url(#${uid}-compact-arrow)`}/>
	<rect class="bgm" x="92.0" y="204" width="64.8" height="12" rx="2"/><text class="lb" x="96.0" y="213.4" text-anchor="start">One port</text>
	<path class="ar dash" d="M156,162 H162 Q170,162 170,170 V272 a8,8 0 0,0 0,16 V292 a8,8 0 0,0 0,16 V398 Q170,406 162,406 H156"/>
	<circle class="bx" cx="170" cy="350" r="7"/><path class="bxl" d="M167,347 L173,353 M173,347 L167,353"/>
	<path class="ar" d="M238,188 V272 Q238,280 230,280 H156" marker-end={`url(#${uid}-compact-arrow)`}/>
	<path class="ar" d="M284,380 V308 Q284,300 276,300 H156" marker-end={`url(#${uid}-compact-arrow)`}/>
	<rect class="bgm" x="12" y="40" width="144" height="52" rx="3"/>
	<rect class="nd" x="12" y="40" width="144" height="52" rx="3"/>
	<text class="nm" x="84.0" y="63.0" text-anchor="middle">Customers</text>
	<text class="sb" x="84.0" y="79.0" text-anchor="middle">web sign-in</text>
	<rect class="bgm" x="194" y="40" width="134" height="52" rx="3"/>
	<rect class="nd" x="194" y="40" width="134" height="52" rx="3"/>
	<text class="nm" x="261.0" y="63.0" text-anchor="middle">Engineers</text>
	<text class="sb" x="261.0" y="79.0" text-anchor="middle">admin role</text>
	<rect class="bgm" x="12" y="136" width="144" height="52" rx="3"/>
	<rect class="nd" x="12" y="136" width="144" height="52" rx="3"/>
	<text class="nm" x="84.0" y="159.0" text-anchor="middle">Web app</text>
	<text class="sb" x="84.0" y="175.0" text-anchor="middle">public web tier</text>
	<rect class="bgm" x="194" y="136" width="134" height="52" rx="3"/>
	<rect class="nd acc" x="194" y="136" width="134" height="52" rx="3"/>
	<text class="nm" x="261.0" y="159.0" text-anchor="middle">Management path</text>
	<text class="sb" x="261.0" y="175.0" text-anchor="middle">separate admin</text>
	<rect class="bgm" x="12" y="260" width="144" height="60" rx="3"/>
	<rect class="nd" x="12" y="260" width="144" height="60" rx="3"/>
	<text class="nm" x="84.0" y="287.0" text-anchor="middle">Billing API</text>
	<text class="sb" x="84.0" y="303.0" text-anchor="middle">accounts, refunds</text>
	<rect class="bgm" x="194" y="380" width="134" height="52" rx="3"/>
	<rect class="nd" x="194" y="380" width="134" height="52" rx="3"/>
	<text class="nm" x="261.0" y="403.0" text-anchor="middle">Support staff</text>
	<text class="sb" x="261.0" y="419.0" text-anchor="middle">refund requests</text>
	<rect class="bgm" x="12" y="380" width="144" height="52" rx="3"/>
	<rect class="nd" x="12" y="380" width="144" height="52" rx="3"/>
	<text class="nm" x="84.0" y="403.0" text-anchor="middle">Database</text>
