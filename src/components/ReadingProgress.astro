---
interface Props {
	/** OKLCH topic hue: colours the bar with the post's first topic. */
	hue?: number;
}

const { hue } = Astro.props as Props;
---

<div
	class:list={['reading-progress', hue !== undefined && 'topic-colored']}
	style={hue !== undefined ? `--topic-hue: ${hue}` : undefined}
	aria-hidden="true"
>
	<div data-reading-progress-bar></div>
</div>

<style>
	.reading-progress {
		position: fixed;
		inset: 0 0 auto;
		z-index: 60;
		height: 2px;
		pointer-events: none;
	}
	[data-reading-progress-bar] {
		height: 100%;
		background: var(--tc, var(--accent));
		transform: scaleX(0);
		transform-origin: left;
	}
</style>

<script>
	import { onPage } from '@/motion/lifecycle';
	// Follows scroll through the article and keeps the masthead's "{n} min left" current.
	onPage((signal) => {
		const bar = document.querySelector<HTMLElement>('[data-reading-progress-bar]');
		const article = document.querySelector<HTMLElement>('article.content');
		if (!bar || !article) return;
		const timeLeft = document.querySelector<HTMLElement>('[data-time-left]');
		const minutes = Number(timeLeft?.dataset.minutes ?? 0);
		let frame = 0;
		const update = () => {
			frame = 0;
			const top = article.getBoundingClientRect().top + window.scrollY;
			const end = top + article.offsetHeight - window.innerHeight;
			const progress =
				end <= top
					? Number(window.scrollY > top)
					: Math.min(1, Math.max(0, (window.scrollY - top) / (end - top)));
			bar.style.transform = `scaleX(${progress})`;
			if (timeLeft && minutes) {
				const left = Math.ceil(minutes * (1 - progress));
				timeLeft.textContent = left > 0 ? `${left} min left` : 'Finished';
			}
		};
		const schedule = () => {
			if (!frame) frame = requestAnimationFrame(update);
		};
		update();
		window.addEventListener('scroll', schedule, { passive: true, signal });
		window.addEventListener('resize', schedule, { passive: true, signal });
		signal.addEventListener('abort', () => cancelAnimationFrame(frame));
	});
</script>
